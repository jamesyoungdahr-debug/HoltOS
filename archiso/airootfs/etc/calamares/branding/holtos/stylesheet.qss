/* HoltOS installer content-area theme — HoltOS Glass, opaque twins.
   Qt Widgets QSS cannot blur, so the installer uses the opaque versions
   of the Glass surfaces: ground holt-deep #0D0B12, inputs/cards on
   holt-raised #1D1927 with a hairline border and radius 10, ink text,
   exactly one purple action per screen (the Next button in the QML top
   bar — every QPushButton inside a page is therefore a quiet, hairline
   secondary button). Type is Nunito (ttf-nunito) with JetBrains Mono for
   the step names in calamares-sidebar.qml.

   Adapted from a real, shipped example (SalientOS's Calamares branding)
   rather than guessed: individual page widgets don't have ids to target,
   so the generic QWidget selector does the base work. Auto-loaded by
   Calamares because it sits next to branding.desc.
*/

QWidget {
    color: rgba(255, 255, 255, 0.85);
    background-color: #0D0B12;
    font-family: "Nunito";
}

QLabel {
    color: rgba(255, 255, 255, 0.85);
    background-color: transparent;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox {
    background-color: #1D1927;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 6px 12px;
    selection-background-color: #B14DFF;
    selection-color: #0D0B12;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border-color: #B14DFF;
}

QComboBox {
    background-color: #1D1927;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 6px 12px;
}
QComboBox:focus { border-color: #B14DFF; }
QComboBox QAbstractItemView {
    background-color: #1D1927;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
    selection-background-color: #B14DFF;
    selection-color: #0D0B12;
}

/* Quiet secondary buttons: the page's one purple action lives in the QML
   top bar (Next), so nothing in the content area shouts. */
QPushButton {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 6px 16px;
    min-width: 80px;
    font-weight: 700;
}
QPushButton:hover { background-color: #1D1927; border-color: rgba(255, 255, 255, 0.28); }
QPushButton:pressed { background-color: #171423; }
QPushButton:disabled { color: rgba(255, 255, 255, 0.28); border-color: rgba(255, 255, 255, 0.09); }

/* Progress draws: a thin 6px bar that fills, no text on it. */
QProgressBar {
    background-color: #1D1927;
    color: transparent;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #B14DFF;
    border-radius: 3px;
}

QCheckBox, QRadioButton {
    color: rgba(255, 255, 255, 0.85);
    background-color: transparent;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background-color: #1D1927;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #B14DFF; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #B14DFF;
    border-color: #B14DFF;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: rgba(255, 255, 255, 0.09);
}

QScrollBar:vertical { background: transparent; width: 10px; border: none; margin: 0; }
QScrollBar::handle:vertical { background: rgba(255, 255, 255, 0.15); border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.28); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QScrollBar:horizontal { background: transparent; height: 10px; border: none; margin: 0; }
QScrollBar::handle:horizontal { background: rgba(255, 255, 255, 0.15); border-radius: 5px; min-width: 24px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; border: none; background: none; }

QListView, QTreeView, QTableView {
    background-color: #171423;
    color: #FFFFFF;
    alternate-background-color: #1D1927;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
}
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #B14DFF;
    color: #0D0B12;
}
QHeaderView::section {
    background-color: #171423;
    color: rgba(255, 255, 255, 0.55);
    border: none;
    padding: 4px 8px;
}

/* Partition page: the "Current:" / "After:" legend under each bar is
   painted by PartitionLabelsView::drawLabel with HARDCODED pens —
   Qt::black for the partition name, Qt::gray for the size line
   (calamares src/modules/partition/gui/PartitionLabelsView.cpp) — so no
   colour rule can reach it; the class-name rule tried on 2026-09-11 was
   still dark-on-dark in build 9 (2026-09-12). The one thing a stylesheet
   CAN change is the view's background, so the legend sits on a light
   glass chip where black + grey text read. Verified: pending (next
   install after this change). */
PartitionLabelsView {
    background-color: rgba(255, 255, 255, 0.88);
    border: none;
    border-radius: 8px;
    padding: 4px;
}
PartitionBarsView {
    background-color: transparent;
    border: none;
}

QToolTip {
    background-color: #1D1927;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 6px 10px;
}

QGroupBox {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: rgba(255, 255, 255, 0.55);
}

QTabWidget::pane { border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 10px; }
QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    padding: 6px 14px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #FFFFFF; border-bottom-color: #B14DFF; }
