# HoltOS Calamares branding — replaces Calamares' own bundled "default"
# placeholder branding (which is where the "Arch Linux Installer" window
# title and "Fancy GNU/Linux ... Venomous Vole" welcome text came from).
---
componentName: holtos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

strings:
    productName:         HoltOS
    shortProductName:    HoltOS
    version:              0.1.0
    shortVersion:         0.1.0
    versionedName:        HoltOS 0.1.0
    shortVersionedName:   HoltOS 0.1.0
    bootloaderEntryName:  HoltOS
    productUrl:           https://github.com/jamesyoungdahr-debug/HoltOS
    supportUrl:           https://github.com/jamesyoungdahr-debug/HoltOS/issues
    knownIssuesUrl:       https://github.com/jamesyoungdahr-debug/HoltOS/issues
    releaseNotesUrl:      https://github.com/jamesyoungdahr-debug/HoltOS

# The otter mark derived from the ComfyUI render (tools/brand/derive_splash_art.py).
images:
    productLogo:          "logo-icon.png"
    productIcon:          "logo-icon.png"
    productWelcome:       "logo-icon.png"

slideshow: "show.qml"

# Horizontal step list along the bottom (calamares-sidebar.qml) and a
# horizontal Back / logo / Cancel / Next bar along the top
# (calamares-navigation.qml) — both custom QML in this branding component,
# replacing Calamares' default vertical left-hand sidebar + button widget.
sidebar: qml,bottom
navigation: qml,top

# Real HoltOS Design System tokens (styles.css): holt-surface / holt-ink /
# holt-current. These are the actual Calamares-recognized style keys
# (SidebarBackground/SidebarText for the normal state,
# SidebarBackgroundCurrent/SidebarTextCurrent for the active step/button) —
# an earlier pass here used invented key names that Calamares silently
# ignored.
style:
   # Stays opaque: the QML bars are QQuickWidgets, which blend a translucent
   # colour onto a grey backing instead of the glass window (tested
   # 2026-09-14), so only the page area between them is glass.
   SidebarBackground:        "#171423"
   SidebarText:               "#8CFFFFFF"
   SidebarBackgroundCurrent:  "#B14DFF"
   SidebarTextCurrent:        "#FFFFFF"
