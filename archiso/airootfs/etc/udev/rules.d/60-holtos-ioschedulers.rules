# HoltOS: I/O scheduler per disk type, from CachyOS-Settings'
# 60-ioschedulers.rules. BFQ keeps a spinning disk responsive under mixed
# load, mq-deadline suits SATA SSDs and SD cards, and kyber keeps NVMe
# latency low under the bursts games and media streaming produce.

# HDD
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", \
    ATTR{queue/scheduler}="bfq"

# SSD
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", \
    ATTR{queue/scheduler}="mq-deadline"

# NVMe SSD
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/rotational}=="0", \
    ATTR{queue/scheduler}="kyber"
