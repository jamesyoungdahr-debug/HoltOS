# System-wide KWin defaults for HoltOS Glass (users' ~/.config/kwinrc
# overrides these).
#
# The blur behind windows is the blur effect inside HoltOS's own KWin
# (package holtos-kwin, src/plugins/blur): it blurs behind EVERY window,
# tints the result towards the ink colour when TintStrength > 0, and
# rounds the blur to the window corners. The old out-of-tree "holtosglass"
# effect (package holtos-glass-effect) stays disabled until the in-tree
# one is verified on a fresh install — never enable both.
[Plugins]
blurEnabled=true
holtosglassEnabled=false
contrastEnabled=true

# See holtos-kwin's src/plugins/blur/blur.kcfg for every key and its meaning.
# BlurStrength 1-15, NoiseStrength 0-14, the rest in percent.
[Effect-blur]
BlurStrength=15
NoiseStrength=4
Saturation=100
Contrast=100
Brightness=100
TintColor=#4A3D66
TintStrength=0
ForceBlur=true
ForceBlurDecorations=true
ForceBlurMenus=true
ForceBlurDocks=false
CornerRadius=10

# HoltOS Glass title bars: our fork of Klassy (package
# holtos-window-decoration, plugin org.holtos.glass) with the glass
# opacity/corner defaults compiled in; etc/skel/.config/klassy/klassyrc
# carries the remaining per-user styling.
[org.kde.kdecoration2]
library=org.holtos.glass
theme=HoltOS Glass
