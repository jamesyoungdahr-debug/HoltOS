# System-wide KWin defaults for HoltOS Glass (users' ~/.config/kwinrc
# overrides these).
#
# The blur behind windows is HoltOS' own KWin effect, "holtosglass"
# (package holtos-glass-effect, a fork of KWin's blur that blurs behind
# EVERY window, tints the result towards the ink colour so text stays
# readable on any wallpaper, and rounds the blur to the window corners).
# It replaces the stock blur — never enable both.
[Plugins]
blurEnabled=false
holtosglassEnabled=true
contrastEnabled=true

# See holtos-glass-effect/src/blur.kcfg for every key and its meaning.
# BlurStrength 1-15, NoiseStrength 0-14, the rest in percent.
[Effect-holtosglass]
BlurStrength=12
NoiseStrength=2
Saturation=150
Contrast=100
Brightness=100
TintColor=#171423
TintStrength=45
ForceBlur=true
ForceBlurDecorations=true
ForceBlurMenus=true
ForceBlurDocks=false
CornerRadius=10

# HoltOS Glass title bars: our fork of Klassy (package
# holtos-window-decoration, plugin org.holtos.glass) with the glass
# opacity/corner defaults compiled in; etc/skel/.config/klassy/klassyrc
# carries the remaining per-user styling.
[org.kde.kdecoration2]
library=org.holtos.glass
theme=HoltOS Glass
