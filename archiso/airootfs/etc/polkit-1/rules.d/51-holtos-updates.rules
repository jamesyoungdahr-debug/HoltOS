// HoltOS updates without a password prompt for the person at the machine:
// Steam's Software Updates page in Game Mode (a controller user has no
// keyboard for a polkit prompt), and the update window's "Check now" /
// "Install now", which only start fixed root services. Those services run
// fixed commands that install only what holtos-update-status found in
// HoltOS' own sources. The one thing a caller chooses is which of those
// updates to install: the instance name of holtos-update-install@.service,
// lowercase item ids joined by "_" (config_flatpak). holtos-update-install
// accepts only known item ids that the last check found, so a crafted name
// installs nothing else. Only the active local session's user, only wheel.
// Written by hand: security-relevant.
polkit.addRule(function(action, subject) {
    if (!(subject.local && subject.active && subject.isInGroup("wheel"))) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "org.holtos.policykit.steamos-update") {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "holtos-update-check.service" ||
             unit == "holtos-update-install.service" ||
             /^holtos-update-install@[a-z]+(-[a-z]+)*(_[a-z]+(-[a-z]+)*)*\.service$/.test(unit)) &&
            verb == "start") {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
