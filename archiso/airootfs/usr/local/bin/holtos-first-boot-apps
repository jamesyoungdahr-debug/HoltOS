#!/bin/bash
# Runs once on first boot of the installed system: installs The Den / The
# Den Client automatically if a tagged release exists for either repo yet.
# Does nothing (quietly logs and moves on) for whichever one doesn't have a
# release yet — same as manually picking it in the tray updater before
# either repo has cut one. A marker file makes this "first boot only";
# running the tray's picker manually afterward still works normally for
# real updates.
set -uo pipefail

MARKER=/var/lib/holtos/first-boot-apps-done
[ -f "$MARKER" ] && exit 0

mkdir -p "$(dirname "$MARKER")"
/usr/local/bin/holtos-update-apply the-den the-den-client
touch "$MARKER"
