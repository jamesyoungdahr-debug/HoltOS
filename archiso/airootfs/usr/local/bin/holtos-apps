#!/usr/bin/env python3
"""HoltOS Apps: the app store.

Browse HoltOS's picks and Flathub's collections and categories, search
Flathub, open an app's page (screenshots, permissions, sizes, release notes),
and install, update and remove apps with real progress. Apps install
system-wide from Flathub; Flatpak's polkit rules let the active local user do
that without a password. The window's parts live in /usr/share/holtos/apps.

  holtos-apps                       open the store
  holtos-apps --updates             open the Updates page
  holtos-apps appstream://APP_ID    open an app's page (links on flathub.org)
  holtos-apps FILE.flatpakref|URL   open the page of the app a Flathub .flatpakref names
"""

import os
import re
import shutil
import sys
import urllib.parse

LIB = os.environ.get("HOLTOS_APPS_LIB", "/usr/share/holtos/apps")
sys.path.insert(0, LIB)

from PySide6.QtCore import QProcess, Qt
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication,
    QButtonGroup,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QMessageBox,
    QPushButton,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

import flathub
from store import Store
from browse import BrowsePage, ListPage
from manage import InstalledPage, UpdatesPage
from app_page import AppPage


ICON_PATH = "/usr/share/icons/hicolor/256x256/apps/holtos-logo.png"
APP_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{2,254}$")
FLATHUB_REPO = "https://dl.flathub.org/repo/"


def app_from_argument(arg):
    """Returns (app_id or None, error message or None)."""

    # Handle appstream://ID or appstream:ID
    if arg.startswith("appstream://"):
        id_ = arg[len("appstream://"):]
        id_ = id_.lstrip("/")
    elif arg.startswith("appstream:"):
        id_ = arg[len("appstream:"):]
    else:
        # Treat as .flatpakref
        if arg.startswith("https://"):
            parsed = urllib.parse.urlparse(arg)
            if parsed.hostname == "dl.flathub.org" and parsed.path.endswith(".flatpakref"):
                basename = os.path.basename(parsed.path)
                id_ = basename.rsplit(".flatpakref", 1)[0]
            else:
                return (None, "HoltOS Apps installs apps from Flathub only.")
        else:
            # Local path
            local_path = arg
            if local_path.startswith("file://"):
                local_path = urllib.parse.unquote(local_path[len("file://"):])

            try:
                with open(local_path, "r", errors="replace") as f:
                    content = f.read(64 * 1024)
            except OSError:
                return (None, f"Could not read {arg}.")

            name = None
            url = None
            in_group = False
            for line in content.splitlines():
                line = line.strip()
                if line == "[Flatpak Ref]":
                    in_group = True
                    continue
                elif line.startswith("["):
                    in_group = False
                    continue
                if in_group and "=" in line:
                    key, _, value = line.partition("=")
                    key = key.strip()
                    value = value.strip()
                    if key == "Name":
                        name = value
                    elif key == "Url":
                        url = value

            if not url or not url.startswith(FLATHUB_REPO):
                return (None, "HoltOS Apps installs apps from Flathub only.")
            id_ = name

    # Validate the app ID
    if not id_ or not APP_ID.match(id_):
        return (None, "That link does not name a valid app.")

    return (id_, None)


# A plain top-level QWidget, not a QMainWindow: Kvantum leaves a QMainWindow
# with a plain central widget opaque, so the store would miss HoltOS glass.
class AppsWindow(QWidget):

    def __init__(self, start_updates=False, open_id=None):
        super().__init__()

        self.setWindowTitle("HoltOS Apps")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.resize(1080, 760)

        layout = QVBoxLayout(self)

        if shutil.which("flatpak") is None:
            layout.addWidget(QLabel("Flatpak is not installed, so apps cannot be installed."))
            self.store = None
            return

        self.store = Store()

        # Top bar with nav buttons and search
        top_bar = QHBoxLayout()

        self.browse_btn = QPushButton("Browse")
        self.installed_btn = QPushButton("Installed")
        self.updates_btn = QPushButton("Updates")

        for btn in (self.browse_btn, self.installed_btn, self.updates_btn):
            btn.setCheckable(True)

        nav_group = QButtonGroup(self)
        nav_group.setExclusive(True)
        nav_group.addButton(self.browse_btn)
        nav_group.addButton(self.installed_btn)
        nav_group.addButton(self.updates_btn)

        top_bar.addWidget(self.browse_btn)
        top_bar.addWidget(self.installed_btn)
        top_bar.addWidget(self.updates_btn)
        top_bar.addStretch()

        self.search = QLineEdit()
        self.search.setPlaceholderText("Search Flathub")
        self.search.setClearButtonEnabled(True)
        self.search.setMinimumWidth(300)
        self.search.returnPressed.connect(self.run_search)
        top_bar.addWidget(self.search)

        layout.addLayout(top_bar)

        # Stacked widget for pages
        self.stack = QStackedWidget()
        self.history = []

        # Create pages using module constructors
        self.browse = BrowsePage(self.store, self.open_app, self.open_list)
        self.list_page = ListPage(self.store, self.open_app, self.back)
        self.app_page = AppPage(self.store, self.back)
        self.installed = InstalledPage(self.store, self.open_app)
        self.updates = UpdatesPage(self.store, self.open_app)

        self.stack.addWidget(self.browse)
        self.stack.addWidget(self.list_page)
        self.stack.addWidget(self.app_page)
        self.stack.addWidget(self.installed)
        self.stack.addWidget(self.updates)

        layout.addWidget(self.stack)

        # Nav button actions
        self.browse_btn.clicked.connect(lambda: self.show_root(self.browse))
        self.installed_btn.clicked.connect(lambda: self.show_root(self.installed))
        self.updates_btn.clicked.connect(lambda: self.show_root(self.updates))

        # Listen for store changes to update counts
        self.store.changed.connect(self.update_counts)
        self.update_counts()

        # Background appstream refresh (fresh install has no Flathub catalogue yet)
        self.appstream = QProcess(self)
        self.appstream.start("flatpak", ["update", "--system", "--appstream", "-y", "--noninteractive"])

        # Initial page
        if start_updates:
            self.show_root(self.updates)
        else:
            self.show_root(self.browse)

        if open_id:
            self.open_app({"id": open_id, "name": open_id, "summary": ""})

    def show_root(self, page):
        """Show *page* as a root (clearing history)."""
        self.history = []
        self.stack.setCurrentWidget(page)
        # Check the matching nav button for browse/list/app pages
        if page is self.browse or page is self.list_page or page is self.app_page:
            self.browse_btn.setChecked(True)
        elif page is self.installed:
            self.installed_btn.setChecked(True)
        elif page is self.updates:
            self.updates_btn.setChecked(True)

    def push(self, page):
        """Push *page* onto the stack, remembering where we came from."""
        current = self.stack.currentWidget()
        if current is not page:
            self.history.append(current)
            self.stack.setCurrentWidget(page)

    def back(self):
        """Go back in history or to Browse root."""
        if self.history:
            self.stack.setCurrentWidget(self.history.pop())
        else:
            self.show_root(self.browse)

    def open_app(self, app):
        """Show the details page for *app*."""
        self.app_page.show_app(app)
        self.push(self.app_page)

    def open_list(self, title, loader):
        """Show a list page with *title*, loaded by *loader(page)* -> apps."""
        self.list_page.show_list(title, loader)
        self.push(self.list_page)

    def run_search(self):
        """Run a Flathub search for the current query text."""
        q = self.search.text().strip()
        if not q:
            return
        self.browse_btn.setChecked(True)
        self.open_list(f'Results for "{q}"', lambda page, q=q: flathub.search(q) if page == 1 else [])

    def update_counts(self):
        """Update the Updates button text with the count of available updates."""
        n = len(self.store.updates)
        self.updates_btn.setText(f"Updates ({n})" if n else "Updates")

    def keyPressEvent(self, event):
        """Handle Escape and Alt+Left as back navigation."""
        if event.key() == Qt.Key_Escape or (event.modifiers() & Qt.AltModifier and event.key() == Qt.Key_Left):
            if self.history:
                self.back()
                return
        super().keyPressEvent(event)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("holtos-apps")
    app.setDesktopFileName("holtos-apps")

    args = sys.argv[1:]
    start_updates = "--updates" in args
    open_id = None

    for arg in args:
        if arg == "--updates":
            continue
        open_id, error = app_from_argument(arg)
        if error:
            QMessageBox.warning(None, "HoltOS Apps", error)
            break

    window = AppsWindow(start_updates, open_id)
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
