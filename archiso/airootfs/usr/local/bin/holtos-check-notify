#!/bin/bash
# Runs the lightweight update check and pops a desktop notification if a
# new tagged release is available, including its release notes (the
# GitHub Release body for that tag, if one exists — a plain git tag with
# no Release object just falls back to the generic message). Pass
# --verbose (used by the tray's "Check for Updates" menu entry) to also
# notify on "up to date" — a manual click going silent would look broken.
# The background timer loop calls this without --verbose so it stays
# quiet until there's actually something to say.
ICON=/usr/share/icons/hicolor/scalable/apps/holtos-logo.svg
REPO="jamesyoungdahr-debug/HoltOS"

if out="$(/usr/local/bin/holtos-update-check)"; then
    tag="${out%% *}"
    notes="$(curl -fsSL "https://api.github.com/repos/$REPO/releases/tags/$tag" 2>/dev/null \
        | jq -r '.body // empty' 2>/dev/null | head -c 300)"
    body="Right-click the HoltOS tray icon and choose Update to install it."
    [ -n "$notes" ] && body="$notes"$'\n\n'"$body"
    notify-send -i "$ICON" "HoltOS $tag available" "$body"
elif [ "${1:-}" = "--verbose" ]; then
    notify-send -i "$ICON" "Everything's fine." "HoltOS is up to date."
fi
