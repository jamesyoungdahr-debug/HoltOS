#!/usr/bin/env python3
"""HoltOS Updates: the update window.

Shows what the updater is doing without anyone having to ask it: the result
of the last check (checking, up to date, or N updates), each available
update with its installed and new version and release notes, live progress
while updates download and install, the update history, and the updater
settings.

Everything privileged runs in root services started through systemd:
polkit lets the active local admin start exactly holtos-update-check and
holtos-update-install (etc/polkit-1/rules.d/51-holtos-updates.rules). This
window only reads /var/lib/holtos/update-status.json,
/run/holtos-update/progress.log and /var/lib/holtos/history.log. Settings
are saved with pkexec holtos-update-settings, which validates every value.
"""
import html
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone

from PySide6.QtCore import QProcess, Qt, QThread, QTime, QTimer, Signal
from PySide6.QtGui import QFontDatabase, QIcon
from PySide6.QtWidgets import (
    QApplication, QCheckBox, QComboBox, QDialog, QDialogButtonBox, QFormLayout,
    QFrame, QHBoxLayout, QHeaderView, QLabel, QLineEdit, QMessageBox, QPlainTextEdit,
    QProgressBar, QPushButton, QScrollArea, QSpinBox, QTableWidget,
    QTableWidgetItem, QTabWidget, QTimeEdit, QToolButton, QVBoxLayout, QWidget,
)

# The Snapshots tab and the Fix updates dialog live beside the other HoltOS
# Updates parts in /usr/share/holtos/updates.
sys.path.insert(0, "/usr/share/holtos/updates")
from repair import RepairDialog  # noqa: E402
from snapshots import SnapshotsTab  # noqa: E402

ICON_PATH = "/usr/share/icons/hicolor/256x256/apps/holtos-logo.png"
STATUS_PATH = "/var/lib/holtos/update-status.json"
PROGRESS_PATH = "/run/holtos-update/progress.log"
HISTORY_PATH = "/var/lib/holtos/history.log"
REBOOT_MARKER = "/run/holtos-reboot-required"
CONF_PATH = "/etc/holtos/updates.conf"

DEFAULTS = {
    "CHECK_INTERVAL": "6h",
    "AUTO_DOWNLOAD": "yes",
    "AUTO_INSTALL": "apps",
    "INSTALL_WINDOW": "",
    "CHECK_AFTER_GAMEMODE": "yes",
    "SNAPSHOT_KEEP": "5",
    "SKIP_RELEASE": "",
    "HOLD_PACKAGES": "",
    "UPDATE_CHANNEL": "stable",
    "DEV_BRANCH": "neon-rebrand",
}
INTERVALS = [
    ("1h", "Every hour"),
    ("6h", "Every 6 hours"),
    ("daily", "Once a day"),
    ("weekly", "Once a week"),
]
AUTO_INSTALL_CHOICES = [
    ("off", "Never, I'll install them myself"),
    ("apps", "HoltOS and apps (ask before system packages)"),
    ("all", "Everything, including system packages and firmware"),
]
CHANNEL_CHOICES = [
    ("stable", "Stable: HoltOS releases"),
    ("dev", "Dev: the newest work, straight from a branch"),
]
NAMES = {
    "config": "HoltOS",
    "the-den": "The Den",
    "the-den-client": "The Den Client",
    "system": "System packages",
    "flatpak": "Flatpak apps",
    "firmware": "Device firmware",
    "extras": "HoltOS components",
    "rollback": "Rollback",
}
STAGE_TEXT = {
    "queued": "Waiting...",
    "check": "Checking...",
    "download": "Downloading...",
    "install": "Installing...",
    "done": "Installed",
    "skip": "Already up to date",
    "fail": "Failed",
}
BUSY_STAGES = ("queued", "check", "download", "install")


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def read_settings():
    settings = dict(DEFAULTS)
    try:
        with open(CONF_PATH) as f:
            for line in f:
                key, sep, value = line.strip().partition("=")
                if sep and key in settings:
                    settings[key] = value.strip('"')
    except OSError:
        pass
    return settings


def friendly_time(stamp):
    if not stamp:
        return "never"
    try:
        when = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).astimezone()
    except ValueError:
        return stamp
    if when.date() == datetime.now().astimezone().date():
        return when.strftime("today at %H:%M")
    return when.strftime("%d %b at %H:%M")


def human_bytes(count):
    size = float(count)
    for unit in ("B", "KB", "MB"):
        if size < 1024:
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} GB"


def start_unit(unit):
    """Starts a root service without waiting for it; returns an error or None."""
    proc = subprocess.run(
        ["systemctl", "start", "--no-block", unit],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return proc.stderr.strip() or f"systemctl exited with {proc.returncode}"
    return None


class UpdateRow(QFrame):
    def __init__(self, update, on_skip=None):
        super().__init__()
        self.setFrameShape(QFrame.StyledPanel)
        layout = QVBoxLayout(self)

        top = QHBoxLayout()
        name = update.get("name") or NAMES.get(update.get("id", ""), update.get("id", "?"))
        self.pick = QCheckBox()
        self.pick.setChecked(True)
        self.pick.setToolTip("Install this update")
        top.addWidget(self.pick)
        top.addWidget(QLabel(f"<b>{html.escape(name)}</b>"))
        top.addStretch()
        current = update.get("current") or ""
        new = update.get("new") or ""
        version = QLabel(f"{current} \u2192 {new}" if current else new)
        version.setTextFormat(Qt.PlainText)
        top.addWidget(version)
        ds = update.get("download_size")
        if ds and ds > 0:
            size_label = QLabel(human_bytes(ds))
            size_label.setTextFormat(Qt.PlainText)
            top.addWidget(size_label)
        self.skip = None
        if update.get("id") == "config" and new and not new.startswith("dev-"):
            self.skip = QPushButton("Skip this version")
            self.skip.clicked.connect(lambda: on_skip(new))
            top.addWidget(self.skip)
        layout.addLayout(top)

        if update.get("restart"):
            layout.addWidget(QLabel("Needs a restart to finish."))

        self.status = QLabel("Ready to install")
        self.bar = QProgressBar()
        self.bar.setRange(0, 100)
        self.bar.setVisible(False)
        layout.addWidget(self.status)
        layout.addWidget(self.bar)

        self.notes = None
        notes = (update.get("notes") or "").strip()
        if update.get("id") == "system" and notes:
            lines = [l for l in notes.splitlines() if l.strip()]
            table = QTableWidget(0, 3)
            table.setHorizontalHeaderLabels(["Package", "Installed", "New"])
            table.verticalHeader().setVisible(False)
            table.setEditTriggers(QTableWidget.NoEditTriggers)
            table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
            table.setMaximumHeight(260)
            for line in lines:
                parts = line.split()
                if len(parts) >= 4:
                    row = table.rowCount()
                    table.insertRow(row)
                    table.setItem(row, 0, QTableWidgetItem(parts[0]))
                    table.setItem(row, 1, QTableWidgetItem(parts[1]))
                    table.setItem(row, 2, QTableWidgetItem(parts[3]))
            self.notes = table
        elif notes:
            self.notes = QLabel(notes)
            self.notes.setTextFormat(Qt.PlainText)
            self.notes.setWordWrap(True)
            self.notes.setTextInteractionFlags(Qt.TextSelectableByMouse)
        if self.notes is not None:
            self.toggle = QToolButton()
            self.toggle.setText("Show details")
            self.toggle.setCheckable(True)
            self.toggle.toggled.connect(self.show_notes)
            self.notes.setVisible(False)
            layout.addWidget(self.toggle, alignment=Qt.AlignLeft)
            layout.addWidget(self.notes)

    def show_notes(self, shown):
        self.notes.setVisible(shown)
        self.toggle.setText("Hide details" if shown else "Show details")

    def picked(self):
        return self.pick.isChecked()

    def set_progress(self, stage, pct, received):
        text = STAGE_TEXT.get(stage, stage)
        if stage == "download":
            if pct >= 0:
                text = f"Downloading {pct}%"
            elif received:
                text = f"Downloading... {human_bytes(received)}"
        self.status.setText(text)
        busy = stage in BUSY_STAGES
        self.pick.setEnabled(not busy)
        self.bar.setVisible(busy)
        if stage == "download" and pct >= 0:
            self.bar.setRange(0, 100)
            self.bar.setValue(pct)
        elif busy:
            self.bar.setRange(0, 0)


class RestartCountdown(QMessageBox):
    """Restarts after a short countdown unless cancelled."""

    def __init__(self, parent, seconds=60):
        super().__init__(parent)
        self.setWindowTitle("HoltOS Updates")
        self.seconds = seconds
        self.restart_button = self.addButton("Restart now", QMessageBox.AcceptRole)
        self.addButton("Cancel", QMessageBox.RejectRole)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(1000)
        self.update_text()

    def update_text(self):
        self.setText(f"Updates are installed. Restarting in {self.seconds} seconds.\n\nSave your work in other apps.")

    def tick(self):
        self.seconds -= 1
        if self.seconds <= 0:
            self.timer.stop()
            self.restart_button.click()
            return
        self.update_text()


class UpdatesTab(QWidget):
    def __init__(self):
        super().__init__()
        self.rows = {}
        self.failed_items = set()
        self.installing = False
        self.shown_updates = None
        self.result_note = ""

        layout = QVBoxLayout(self)
        header = QHBoxLayout()
        self.title = QLabel()
        self.title.setStyleSheet("font-size: 16pt; font-weight: 600;")
        header.addWidget(self.title)
        header.addStretch()
        self.check_button = QPushButton("Check for updates")
        self.check_button.clicked.connect(self.check_now)
        header.addWidget(self.check_button)
        layout.addLayout(header)

        self.subtitle = QLabel()
        self.subtitle.setWordWrap(True)
        layout.addWidget(self.subtitle)
        self.busy = QProgressBar()
        self.busy.setRange(0, 0)
        self.busy.setVisible(False)
        layout.addWidget(self.busy)

        self.restart_banner = QFrame()
        self.restart_banner.setFrameShape(QFrame.StyledPanel)
        banner = QHBoxLayout(self.restart_banner)
        self.restart_text = QLabel()
        self.restart_text.setWordWrap(True)
        banner.addWidget(self.restart_text, 1)
        restart = QPushButton("Restart now")
        restart.clicked.connect(self.restart_now)
        banner.addWidget(restart)
        self.restart_banner.setVisible(False)
        layout.addWidget(self.restart_banner)

        self.failure_banner = QFrame()
        self.failure_banner.setFrameShape(QFrame.StyledPanel)
        failure = QHBoxLayout(self.failure_banner)
        self.failure_text = QLabel()
        self.failure_text.setWordWrap(True)
        failure.addWidget(self.failure_text, 1)
        for text, slot in (("Show log", self.show_log), ("Retry", self.retry), ("Create support bundle", self.support_bundle)):
            button = QPushButton(text)
            button.clicked.connect(slot)
            failure.addWidget(button)
        self.bundle_proc = None
        self.failure_banner.setVisible(False)
        layout.addWidget(self.failure_banner)

        self.list_host = QWidget()
        self.list_layout = QVBoxLayout(self.list_host)
        self.list_layout.addStretch()
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(self.list_host)
        layout.addWidget(scroll, 1)

        footer = QHBoxLayout()
        footer.addStretch()
        self.install_button = QPushButton("Install selected")
        self.install_button.clicked.connect(self.install_now)
        self.restart_after = QCheckBox("Restart when finished")
        footer.addWidget(self.restart_after)
        footer.addWidget(self.install_button)
        layout.addLayout(footer)

        # Replay the progress log only if an install is still running;
        # otherwise start after whatever is already in it.
        lines = self.progress_lines()
        if lines and not lines[-1].startswith("@@ all finished"):
            self.progress_offset = 0
        else:
            self.progress_offset = len(lines)

        # The status file is replaced atomically and may not exist yet, so
        # poll it instead of watching it.
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(1000)
        self.refresh()

    @staticmethod
    def progress_lines():
        try:
            with open(PROGRESS_PATH) as f:
                return f.read().splitlines()
        except OSError:
            return []

    def refresh(self):
        status = read_json(STATUS_PATH) or {"state": "unknown", "updates": []}
        updates = status.get("updates", [])
        key = json.dumps(updates, sort_keys=True)
        if key != self.shown_updates and not self.installing:
            self.shown_updates = key
            self.show_updates(updates)
        self.follow_progress()
        self.show_state(status)
        self.show_restart()

    def show_updates(self, updates):
        for row in self.rows.values():
            row.deleteLater()
        self.rows = {}
        for update in updates:
            row = UpdateRow(update, self.skip_release)
            self.rows[update.get("id", "")] = row
            self.list_layout.insertWidget(self.list_layout.count() - 1, row)

    def show_state(self, status):
        state = status.get("state")
        updates = status.get("updates", [])
        checked = friendly_time(status.get("checked_at"))
        checking = state == "checking"
        note = f" {self.result_note}" if self.result_note else ""
        self.busy.setVisible(checking and not self.installing)
        self.check_button.setEnabled(not checking and not self.installing)
        self.install_button.setVisible(bool(updates))
        self.install_button.setEnabled(bool(updates) and not checking and not self.installing)
        if self.installing:
            self.title.setText("Installing updates...")
            self.subtitle.setText("You can keep using the computer while this runs.")
        elif checking:
            self.title.setText("Checking for updates...")
            self.subtitle.setText(
                "Looking for new versions of HoltOS, The Den, system packages "
                "(kernel, drivers and everything else), Flatpak apps and device firmware."
            )
        elif state == "available":
            count = len(updates)
            self.title.setText(f"{count} update{'s' if count != 1 else ''} available")
            subtitle_text = f"Last checked {checked}.{note}"
            deferred = status.get("deferred")
            if deferred and not self.installing:
                subtitle_text += f" Automatic updates are waiting because {deferred}."
            self.subtitle.setText(subtitle_text)
        elif state == "up_to_date":
            self.title.setText("You're up to date")
            subtitle_text = f"Last checked {checked}.{note}"
            deferred = status.get("deferred")
            if deferred and not self.installing:
                subtitle_text += f" Automatic updates are waiting because {deferred}."
            self.subtitle.setText(subtitle_text)
        elif state == "error":
            self.title.setText("Couldn't check for updates")
            self.subtitle.setText(f"{status.get('error') or 'Unknown error'} (last attempt {checked}).")
        else:
            self.title.setText("No update check has run yet")
            self.subtitle.setText("HoltOS checks for updates automatically; you can also check now.")

    def follow_progress(self):
        lines = self.progress_lines()
        if len(lines) < self.progress_offset:
            self.progress_offset = 0
        new_lines = lines[self.progress_offset:]
        self.progress_offset = len(lines)
        for line in new_lines:
            parts = line.split()
            if len(parts) < 4 or parts[0] != "@@":
                continue
            item, stage = parts[1], parts[2]
            if item == "all" and stage == "finished":
                self.finish_install(parts[3])
                continue
            try:
                pct = int(parts[3])
            except ValueError:
                pct = -1
            received = int(parts[4]) if len(parts) > 4 and parts[4].isdigit() else 0
            if stage in BUSY_STAGES:
                # Also catches installs started elsewhere: the tray, the
                # schedule, or Steam in Game Mode.
                self.installing = True
            row = self.rows.get(item)
            if row:
                if stage == "fail":
                    self.failed_items.add(item)
                row.set_progress(stage, pct, received)

    def finish_install(self, code):
        self.installing = False
        self.shown_updates = None
        if code == "0":
            self.result_note = "The last install finished."
            self.failure_banner.setVisible(False)
            if self.restart_after.isChecked():
                self.restart_after.setChecked(False)
                box = RestartCountdown(self)
                box.exec()
                if box.clickedButton() is box.restart_button:
                    subprocess.Popen(["systemctl", "reboot"])
        else:
            self.result_note = f"The last install had errors (exit {code}); the History tab shows what was applied."
            self.show_failure()

    @staticmethod
    def read_text(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            return ""

    def install_warnings(self):
        """Reasons to wait before installing, checked without root."""
        warnings = []
        base = "/sys/class/power_supply"
        on_ac = False
        capacity = None
        try:
            supplies = os.listdir(base)
        except OSError:
            supplies = []
        for name in supplies:
            kind = self.read_text(os.path.join(base, name, "type"))
            if kind in ("Mains", "USB") and self.read_text(os.path.join(base, name, "online")) == "1":
                on_ac = True
            elif kind == "Battery":
                value = self.read_text(os.path.join(base, name, "capacity"))
                if value.isdigit():
                    capacity = int(value) if capacity is None else min(capacity, int(value))
        if capacity is not None and not on_ac and capacity < 30:
            warnings.append(f"The battery is at {capacity} %. Plug in the charger so the update is not interrupted.")
        try:
            free = shutil.disk_usage("/").free
            if free < 2 * 1024 ** 3:
                warnings.append(f"Only {human_bytes(free)} is free on the system disk.")
        except OSError:
            pass
        try:
            metered = subprocess.run(
                ["nmcli", "-t", "-g", "GENERAL.METERED", "device", "show"],
                capture_output=True, text=True, timeout=5,
            ).stdout
            if any(line.startswith("yes") for line in metered.splitlines()):
                warnings.append("The network connection is metered, so this download may cost data.")
        except (OSError, subprocess.SubprocessError):
            pass
        return warnings

    def skip_release(self, tag):
        answer = QMessageBox.question(
            self, "HoltOS Updates",
            f"Skip HoltOS {tag}? It will not be offered again; newer releases still will.",
        )
        if answer != QMessageBox.Yes:
            return
        proc = subprocess.run(
            ["pkexec", "/usr/local/bin/holtos-update-settings", f"SKIP_RELEASE={tag}"],
            capture_output=True, text=True,
        )
        if proc.returncode == 0:
            start_unit("holtos-update-check.service")
        elif proc.returncode not in (126, 127):
            QMessageBox.warning(self, "HoltOS Updates", f"Could not skip {tag}:\n{proc.stderr.strip()}")

    def check_now(self):
        error = start_unit("holtos-update-check.service")
        if error:
            QMessageBox.warning(self, "HoltOS Updates", f"Could not start the update check:\n{error}")

    def install_now(self):
        ids = [uid for uid, row in self.rows.items() if row.picked()]
        if not ids:
            QMessageBox.information(self, "HoltOS Updates", "Tick at least one update to install.")
            return
        warnings = self.install_warnings()
        if warnings and QMessageBox.question(
                self, "HoltOS Updates",
                "Install now anyway?\n\n" + "\n".join("• " + w for w in warnings)
        ) != QMessageBox.Yes:
            return
        unit = ("holtos-update-install.service"
                if len(ids) == len(self.rows)
                else f"holtos-update-install@{'_'.join(ids)}.service")
        error = start_unit(unit)
        if error:
            QMessageBox.warning(self, "HoltOS Updates", f"Could not start the install:\n{error}")
            return
        self.installing = True
        self.result_note = ""
        self.failed_items = set()
        self.failure_banner.setVisible(False)
        for row in self.rows.values():
            if row.picked():
                row.set_progress("queued", -1, 0)

    def show_failure(self):
        names = [NAMES.get(item, item) for item in self.rows if item in self.failed_items]
        if names:
            self.failure_text.setText(f"These updates did not finish: {', '.join(names)}.")
        else:
            self.failure_text.setText("The last install did not finish.")
        self.failure_banner.setVisible(True)

    def show_log(self):
        try:
            with open(PROGRESS_PATH) as f:
                lines = [line for line in f.read().splitlines() if not line.startswith("@@ ")]
        except OSError:
            lines = ["The install log is not available (it is cleared when the computer restarts)."]
        dialog = QDialog(self)
        dialog.setWindowTitle("Install log")
        dialog.resize(720, 480)
        box = QVBoxLayout(dialog)
        text = QPlainTextEdit("\n".join(lines[-400:]))
        text.setReadOnly(True)
        text.setFont(QFontDatabase.systemFont(QFontDatabase.FixedFont))
        box.addWidget(text)
        buttons = QDialogButtonBox(QDialogButtonBox.Close)
        buttons.rejected.connect(dialog.reject)
        box.addWidget(buttons)
        dialog.exec()

    def retry(self):
        # Only the updates that failed, in the order the check lists them.
        ids = [item for item in self.rows if item in self.failed_items]
        unit = f"holtos-update-install@{'_'.join(ids)}.service" if ids else "holtos-update-install.service"
        error = start_unit(unit)
        if error:
            QMessageBox.warning(self, "HoltOS Updates", f"Could not start the install:\n{error}")
            return
        self.installing = True
        self.result_note = ""
        self.failure_banner.setVisible(False)
        for item, row in self.rows.items():
            if not ids or item in ids:
                row.set_progress("queued", -1, 0)
        self.failed_items = set()

    def support_bundle(self):
        if self.bundle_proc is not None:
            return
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.MergedChannels)
        proc.finished.connect(lambda code, _status, p=proc: self.bundle_done(p, code))
        self.bundle_proc = proc
        self.failure_text.setText(self.failure_text.text() + " Creating a support bundle...")
        proc.start("/usr/local/bin/holtos-support-bundle", [])

    def bundle_done(self, proc, code):
        output = bytes(proc.readAll()).decode(errors="replace").strip().splitlines()
        proc.deleteLater()
        self.bundle_proc = None
        self.show_failure()
        saved = [line for line in output if line.startswith("Support bundle saved: ")]
        if code == 0 and saved:
            path = saved[-1].replace("Support bundle saved: ", "")
            QMessageBox.information(self, "HoltOS Updates", f"Support bundle saved:\n{path}\n\nAttach it to your bug report.")
        else:
            QMessageBox.warning(self, "HoltOS Updates", "The support bundle could not be created:\n" + "\n".join(output[-5:]))

    def show_restart(self):
        try:
            with open(REBOOT_MARKER) as f:
                reason = f.read().strip()
        except OSError:
            self.restart_banner.setVisible(False)
            return
        self.restart_text.setText(f"Restart to finish updating: {reason}.")
        self.restart_banner.setVisible(True)

    def restart_now(self):
        answer = QMessageBox.question(
            self, "HoltOS Updates",
            "Restart now? Save your work in other apps first.",
        )
        if answer == QMessageBox.Yes:
            subprocess.Popen(["systemctl", "reboot"])


class HistoryTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        self.table = QTableWidget(0, 3)
        self.table.setHorizontalHeaderLabels(["When", "What", "Version"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.verticalHeader().setVisible(False)
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        layout.addWidget(self.table)
        self.mtime = None
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(3000)
        self.refresh()

    def refresh(self):
        try:
            mtime = os.path.getmtime(HISTORY_PATH)
        except OSError:
            mtime = None
        if mtime == self.mtime:
            return
        self.mtime = mtime
        entries = []
        try:
            with open(HISTORY_PATH) as f:
                for line in f:
                    parts = line.rstrip("\n").split("\t")
                    if len(parts) >= 3:
                        entries.append(parts)
        except OSError:
            pass
        entries.reverse()
        self.table.setRowCount(len(entries))
        for row, parts in enumerate(entries):
            version = "updated" if parts[1] in ("system", "flatpak", "firmware", "extras") else parts[2]
            cells = (friendly_time(parts[0]), NAMES.get(parts[1], parts[1]), version)
            for column, text in enumerate(cells):
                self.table.setItem(row, column, QTableWidgetItem(text))


def sound_devices(kind):
    """Names of the speakers ("sinks") or microphones ("sources") PipeWire
    can see, or None when it cannot be asked. Monitor sources (the copy of
    what a speaker plays) are not microphones and are left out."""
    try:
        proc = subprocess.run(
            ["pactl", "-f", "json", "list", kind],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    try:
        devices = json.loads(proc.stdout)
    except ValueError:
        return None
    names = []
    for device in devices if isinstance(devices, list) else []:
        if not isinstance(device, dict):
            continue
        name = str(device.get("name", ""))
        if kind == "sources" and (
            name.endswith(".monitor")
            or device.get("monitor_of_sink") not in (None, "", "n/a")
        ):
            continue
        names.append(str(device.get("description") or name))
    return names


# AMD audio coprocessor 7.x (Strix Halo / Strix Point, PCI 1022:15e2). Its
# built-in digital microphones get no capture device on Linux yet: the
# kernel has no machine driver or quirk for most of these laptops and
# alsa-ucm-conf has no ACP 7 profile (alsa-ucm-conf issue 745, linux-cachyos
# issue 880 for the ROG Flow Z13; unfixed as of 2026-09). Nothing HoltOS can
# configure fixes it, so the Hardware tab says so instead.
ACP7_PCI_ID = "1022:15e2"


class HardwareCheck(QThread):
    """Runs the driver and sound device checks without freezing the window."""

    done = Signal(dict)

    def run(self):
        result = {
            "error": "", "rows": [], "missing": 0,
            "speakers": None, "microphones": None, "acp7": False,
        }
        try:
            proc = subprocess.run(
                ["/usr/local/bin/holtos-hardware", "needed"],
                capture_output=True, text=True, timeout=20,
            )
        except FileNotFoundError:
            proc = None
            result["error"] = "the hardware check (holtos-hardware) is not installed"
        except (OSError, subprocess.SubprocessError) as exc:
            proc = None
            result["error"] = f"the hardware check did not finish ({exc.__class__.__name__})"
        if proc is not None and proc.returncode != 0:
            detail = (proc.stderr or "").strip().splitlines()
            result["error"] = detail[-1] if detail else f"the hardware check stopped with code {proc.returncode}"
        elif proc is not None:
            for line in proc.stdout.splitlines():
                pkg, _, what = line.partition("\t")
                pkg = pkg.strip()
                if not pkg:
                    continue
                try:
                    query = subprocess.run(["pacman", "-Q", pkg], capture_output=True, text=True, timeout=10)
                except (OSError, subprocess.SubprocessError):
                    query = None
                if query is None:
                    status = "Could not check"
                elif query.returncode == 0:
                    status = "Installed " + query.stdout.split()[-1]
                else:
                    status = "Not installed yet: the next update adds it"
                    result["missing"] += 1
                result["rows"].append((pkg, what, status))
        result["speakers"] = sound_devices("sinks")
        result["microphones"] = sound_devices("sources")
        try:
            lspci = subprocess.run(["lspci", "-n"], capture_output=True, text=True, timeout=5).stdout
            result["acp7"] = f" {ACP7_PCI_ID}" in lspci
        except (OSError, subprocess.SubprocessError):
            pass
        self.done.emit(result)


class HardwareTab(QWidget):
    """The drivers holtos-hardware finds this computer needs, whether each is
    installed, and the sound devices PipeWire can see."""

    def __init__(self):
        super().__init__()
        self.check = None
        self.checked_once = False
        layout = QVBoxLayout(self)
        intro = QLabel(
            "HoltOS checks this computer's hardware and installs the drivers it "
            "needs, when you install and with every update. Graphics for AMD and "
            "Intel, firmware, audio and Bluetooth are built in for everyone."
        )
        intro.setWordWrap(True)
        layout.addWidget(intro)
        self.table = QTableWidget(0, 3)
        self.table.setHorizontalHeaderLabels(["Driver", "For", "Status"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.verticalHeader().setVisible(False)
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        layout.addWidget(self.table, 1)

        layout.addWidget(QLabel("Sound devices"))
        self.sound = QTableWidget(0, 2)
        self.sound.setHorizontalHeaderLabels(["Device", "Found"])
        self.sound.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.sound.verticalHeader().setVisible(False)
        self.sound.setEditTriggers(QTableWidget.NoEditTriggers)
        self.sound.setWordWrap(True)
        layout.addWidget(self.sound)
        self.show_sound(None, None, False, checking=True)

        footer = QHBoxLayout()
        self.status = QLabel("")
        self.status.setWordWrap(True)
        footer.addWidget(self.status, 1)
        self.again = QPushButton("Check again")
        self.again.clicked.connect(self.refresh)
        footer.addWidget(self.again)
        layout.addLayout(footer)
        QApplication.instance().aboutToQuit.connect(self.wait_for_check)
        self.refresh()

    def refresh(self):
        if self.check is not None and self.check.isRunning():
            return
        self.again.setEnabled(False)
        self.again.setText("Checking...")
        self.status.setText("Checking this computer's drivers and sound devices...")
        self.check = HardwareCheck(self)
        self.check.done.connect(self.show_result)
        self.check.start()

    def wait_for_check(self):
        if self.check is not None and self.check.isRunning():
            self.check.wait(30000)

    def fill(self, table, rows):
        table.setRowCount(len(rows))
        for row, cells in enumerate(rows):
            for column, text in enumerate(cells):
                item = QTableWidgetItem(text)
                item.setToolTip(text)
                table.setItem(row, column, item)
        table.resizeRowsToContents()

    def show_sound(self, speakers, microphones, acp7, checking=False):
        rows = []
        for label, names in (("Speakers and headphones", speakers), ("Microphones", microphones)):
            if checking:
                text = "Checking..."
            elif names is None:
                text = "Could not check: the sound service (PipeWire) is not answering"
            elif names:
                text = ", ".join(names)
            elif label == "Microphones":
                text = "None found. A USB, Bluetooth or headset microphone should appear here when plugged in."
            else:
                text = "None found"
            rows.append((label, text))
        if acp7 and not checking:
            rows.append((
                "Built-in microphone",
                "Not supported on Linux yet: this computer's digital microphones sit on "
                "AMD's audio coprocessor 7, which Linux does not drive yet. Any microphone "
                "listed above may be silent. A USB, Bluetooth or headset microphone works.",
            ))
        self.fill(self.sound, rows)
        self.sound.setFixedHeight(
            self.sound.horizontalHeader().height()
            + sum(self.sound.rowHeight(r) for r in range(self.sound.rowCount())) + 4
        )

    def show_result(self, result):
        now = datetime.now().strftime("%H:%M")
        self.again.setEnabled(True)
        self.again.setText("Check again")
        if result["error"]:
            if self.checked_once:
                self.status.setText(
                    f"Check failed at {now}: {result['error']}. "
                    "The list above is from the last check that worked."
                )
            else:
                self.fill(self.table, [("-", "The hardware check failed", result["error"])])
                self.status.setText(f"Check failed at {now}: {result['error']}.")
        else:
            self.checked_once = True
            total, missing = len(result["rows"]), result["missing"]
            self.fill(self.table, result["rows"] or [("None needed", "This computer needs no extra drivers", "")])
            if total == 0:
                summary = "no extra drivers needed"
            elif missing == 0:
                summary = f"{total} driver{'' if total == 1 else 's'}, all installed"
            else:
                summary = f"{missing} of {total} drivers not installed yet; the next update adds them"
            self.status.setText(f"Checked at {now}: {summary}.")
        self.show_sound(result["speakers"], result["microphones"], result["acp7"])


class SettingsTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        form = QFormLayout()
        form.setLabelAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        form.setFormAlignment(Qt.AlignLeft | Qt.AlignTop)
        form.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)

        # Update channel (first row)
        channel_row = QHBoxLayout()
        self.channel = QComboBox()
        for value, text in CHANNEL_CHOICES:
            self.channel.addItem(text, value)
        channel_row.addWidget(self.channel, 1)
        self.dev_branch = QLineEdit()
        self.dev_branch.setPlaceholderText("neon-rebrand")
        self.dev_branch.setMaximumWidth(200)
        channel_row.addWidget(self.dev_branch)
        form.addRow("Update channel:", channel_row)
        self.channel_note = QLabel(
            "The dev channel installs unfinished work from the HoltOS repository as soon as it is pushed. "
            "It can break things; a snapshot is still taken before every update. "
            "To go back to Stable, restore the snapshot from before you switched (Snapshots tab)."
        )
        self.channel_note.setWordWrap(True)
        form.addRow("", self.channel_note)
        self.channel.currentIndexChanged.connect(self.update_channel_state)

        self.interval = QComboBox()
        for value, text in INTERVALS:
            self.interval.addItem(text, value)
        form.addRow("Check for updates:", self.interval)

        self.auto_download = QCheckBox("Download updates automatically")
        form.addRow("", self.auto_download)

        self.auto_install = QComboBox()
        for value, text in AUTO_INSTALL_CHOICES:
            self.auto_install.addItem(text, value)
        form.addRow("Install automatically:", self.auto_install)

        window_row = QHBoxLayout()
        self.use_window = QCheckBox("Only install system updates at")
        self.window_time = QTimeEdit()
        self.window_time.setDisplayFormat("HH:00")
        self.use_window.toggled.connect(self.window_time.setEnabled)
        window_row.addWidget(self.use_window)
        window_row.addWidget(self.window_time)
        window_row.addStretch()
        form.addRow("Install window:", window_row)

        self.after_gamemode = QCheckBox("Check for updates when leaving Game Mode")
        form.addRow("", self.after_gamemode)

        self.snapshot_keep = QSpinBox()
        self.snapshot_keep.setRange(2, 10)
        self.snapshot_keep.setSuffix(" snapshots")
        form.addRow("Keep before updates:", self.snapshot_keep)
        keep_note = QLabel("HoltOS takes a snapshot before every update so it can be undone. "
                           "Older snapshots are removed beyond this number.")
        keep_note.setWordWrap(True)
        form.addRow("", keep_note)

        self.holds = QLineEdit()
        self.holds.setPlaceholderText("Package names, separated by spaces")
        form.addRow("Hold packages:", self.holds)
        holds_note = QLabel("Held packages stay at their current version during system updates. "
                            "Holding one for long can break other updates, so release it when you can.")
        holds_note.setWordWrap(True)
        form.addRow("", holds_note)
        layout.addLayout(form)

        repair_row = QHBoxLayout()
        repair_note = QLabel("Updates keep failing? Fix updates clears a stuck update, repairs the "
                             "package keys and picks fast mirrors.")
        repair_note.setWordWrap(True)
        repair_row.addWidget(repair_note, 1)
        fix = QPushButton("Fix updates...")
        fix.clicked.connect(self.fix_updates)
        repair_row.addWidget(fix)
        layout.addLayout(repair_row)

        buttons = QHBoxLayout()
        buttons.addStretch()
        save = QPushButton("Save")
        save.clicked.connect(self.save)
        buttons.addWidget(save)
        layout.addLayout(buttons)
        layout.addStretch()
        self.load()

    def update_channel_state(self):
        dev = self.channel.currentData() == "dev"
        self.dev_branch.setEnabled(dev)
        self.channel_note.setVisible(dev)

    def load(self):
        settings = read_settings()
        index = self.interval.findData(settings["CHECK_INTERVAL"])
        self.interval.setCurrentIndex(index if index >= 0 else 1)
        self.auto_download.setChecked(settings["AUTO_DOWNLOAD"] == "yes")
        index = self.auto_install.findData(settings["AUTO_INSTALL"])
        self.auto_install.setCurrentIndex(index if index >= 0 else 1)
        hour = settings["INSTALL_WINDOW"].split(":")[0]
        has_window = hour.isdigit()
        self.use_window.setChecked(has_window)
        self.window_time.setTime(QTime(int(hour), 0) if has_window else QTime(4, 0))
        self.window_time.setEnabled(has_window)
        self.after_gamemode.setChecked(settings["CHECK_AFTER_GAMEMODE"] != "no")
        keep = settings["SNAPSHOT_KEEP"]
        self.snapshot_keep.setValue(int(keep) if keep.isdigit() and 2 <= int(keep) <= 10 else 5)
        self.holds.setText(settings["HOLD_PACKAGES"])
        index = self.channel.findData(settings["UPDATE_CHANNEL"])
        self.channel.setCurrentIndex(index if index >= 0 else 0)
        self.dev_branch.setText(settings["DEV_BRANCH"])
        self.update_channel_state()

    def fix_updates(self):
        RepairDialog(self).exec()

    def save(self):
        window = f"{self.window_time.time().hour():02d}:00" if self.use_window.isChecked() else ""
        args = [
            f"CHECK_INTERVAL={self.interval.currentData()}",
            f"AUTO_DOWNLOAD={'yes' if self.auto_download.isChecked() else 'no'}",
            f"AUTO_INSTALL={self.auto_install.currentData()}",
            f"INSTALL_WINDOW={window}",
            f"CHECK_AFTER_GAMEMODE={'yes' if self.after_gamemode.isChecked() else 'no'}",
            f"SNAPSHOT_KEEP={self.snapshot_keep.value()}",
            f"HOLD_PACKAGES={' '.join(self.holds.text().split())}",
            f"UPDATE_CHANNEL={self.channel.currentData()}",
            f"DEV_BRANCH={self.dev_branch.text().strip() or 'neon-rebrand'}",
        ]
        proc = subprocess.run(
            ["pkexec", "/usr/local/bin/holtos-update-settings", *args],
            capture_output=True, text=True,
        )
        if proc.returncode == 0:
            QMessageBox.information(self, "HoltOS Updates", "Settings saved.")
        elif proc.returncode not in (126, 127):
            QMessageBox.warning(self, "HoltOS Updates", f"Could not save the settings:\n{proc.stderr.strip()}")
        self.load()


class UpdatesWindow(QTabWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("HoltOS Updates")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.resize(660, 580)
        self.addTab(UpdatesTab(), "Updates")
        self.addTab(HistoryTab(), "History")
        self.addTab(SnapshotsTab(), "Snapshots")
        self.addTab(HardwareTab(), "Hardware")
        self.addTab(SettingsTab(), "Settings")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("holtos-updates")
    app.setDesktopFileName("holtos-updater")
    window = UpdatesWindow()
    if "--settings" in sys.argv:
        window.setCurrentIndex(4)
    elif "--snapshots" in sys.argv:
        window.setCurrentIndex(2)
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
