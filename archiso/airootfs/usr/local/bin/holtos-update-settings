#!/bin/bash
# Saves the updater settings the update window edits, as root:
#   pkexec holtos-update-settings KEY=VALUE ...
# Every key and value is checked against a fixed list before anything is
# written, so /etc/holtos/updates.conf only ever holds values the other
# scripts expect (they parse it, they never source it). Also points the
# check timer at the chosen interval. Written by hand: a root helper that
# takes input from a user session.
set -euo pipefail

CONF=/etc/holtos/updates.conf
DROPIN_DIR=/etc/systemd/system/holtos-update-check.timer.d

if [ "$(id -u)" -ne 0 ]; then
    echo "holtos-update-settings must run as root (use: pkexec holtos-update-settings ...)" >&2
    exit 1
fi

declare -A setting=(
    [CHECK_INTERVAL]=6h
    [AUTO_DOWNLOAD]=yes
    [AUTO_INSTALL]=apps
    [INSTALL_WINDOW]=""
    [CHECK_AFTER_GAMEMODE]=yes
)

valid() {
    case "$1" in
        CHECK_INTERVAL) [[ "$2" =~ ^(1h|6h|daily|weekly)$ ]] ;;
        AUTO_DOWNLOAD|CHECK_AFTER_GAMEMODE) [[ "$2" =~ ^(yes|no)$ ]] ;;
        AUTO_INSTALL) [[ "$2" =~ ^(off|apps|all)$ ]] ;;
        INSTALL_WINDOW) [[ "$2" =~ ^(([01][0-9]|2[0-3]):00)?$ ]] ;;
        *) return 1 ;;
    esac
}

# Start from the saved values; anything unknown or invalid in the file is
# dropped back to its default.
if [ -f "$CONF" ]; then
    while IFS='=' read -r key value; do
        value="${value%\"}"
        value="${value#\"}"
        if [ -n "${setting[$key]+set}" ] && valid "$key" "$value"; then
            setting[$key]="$value"
        fi
    done < "$CONF"
fi

for pair in "$@"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    if [ "$key" = "$pair" ] || [ -z "${setting[$key]+set}" ]; then
        echo "Unknown setting: $pair" >&2
        exit 2
    fi
    if ! valid "$key" "$value"; then
        echo "Invalid value for $key: $value" >&2
        exit 2
    fi
    setting[$key]="$value"
done

mkdir -p "$(dirname "$CONF")"
tmp="$(mktemp "$CONF.XXXXXX")"
{
    echo "# HoltOS updater settings. Edit them in HoltOS Updates > Settings."
    for key in CHECK_INTERVAL AUTO_DOWNLOAD AUTO_INSTALL INSTALL_WINDOW CHECK_AFTER_GAMEMODE; do
        printf '%s=%s\n' "$key" "${setting[$key]}"
    done
} > "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$CONF"

case "${setting[CHECK_INTERVAL]}" in
    1h) interval=1h ;;
    6h) interval=6h ;;
    daily) interval=1d ;;
    weekly) interval=7d ;;
esac
mkdir -p "$DROPIN_DIR"
printf '[Timer]\nOnUnitActiveSec=\nOnUnitActiveSec=%s\n' "$interval" > "$DROPIN_DIR/interval.conf"
chmod 644 "$DROPIN_DIR/interval.conf"

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl restart holtos-update-check.timer 2>/dev/null || true
fi
echo "Saved."
