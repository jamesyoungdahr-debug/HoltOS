#!/usr/bin/env bash
# Shares folders on this computer with the local network over SMB (Samba),
# the root half of the "This computer" page in HoltOS' Network Shares. The
# GUI calls it through pkexec. Each shared folder is a small KEY=VALUE file
# in /etc/holtos/samba/<name>.conf; from those this script writes the whole
# of /etc/samba/smb.conf, checks it with testparm before using it, and runs
# Samba (smb) and Windows network discovery (wsdd) only while something is
# shared. Written by hand: a root helper that takes input from a user session
# and decides what the network can reach.
#
#   holtos-samba list                          (any user) NAME PATH OWNER GUEST READONLY per line
#   holtos-samba status                        (any user) running|stopped, then users with a network password
#   holtos-samba add NAME PATH [--guest] [--read-only]
#                   --guest      anyone on the network may open it, read-only
#                   --read-only  the owner cannot change files over the network either
#   holtos-samba remove NAME
#   holtos-samba password                      set your network password (read from stdin)
#
# Safety rules:
# - Only folders below the owner's home (not the home itself, nothing hidden
#   such as ~/.ssh), or below /mnt, /media, /run/media/<owner> or /srv.
#   Never network shares mounted under /mnt/shares.
# - Files are read and written as the owner (force user), so the network
#   can never do more than the owner could. Guests only ever read.
# - Only private and link-local addresses may connect (hosts allow), SMB2
#   or newer, no NetBIOS, no printers, no home-folder shares.
set -euo pipefail

CONF_DIR=/etc/holtos/samba
USERS_DIR=/etc/holtos/samba/users
SMB_CONF=/etc/samba/smb.conf
MARKER="# Generated by holtos-samba"

valid_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,23}$ ]] || return 1
    case "${1,,}" in
        global|homes|printers|print\$|ipc\$) return 1 ;;
    esac
    return 0
}

die() { echo "$*" >&2; exit 2; }

# The desktop user who asked, from pkexec (or sudo). Never root.
owner_name() {
    local uid="${PKEXEC_UID:-${SUDO_UID:-}}" name
    [ -n "$uid" ] || die "run this from the desktop (pkexec), so HoltOS knows whose folder it is"
    [[ "$uid" =~ ^[0-9]+$ ]] && [ "$uid" -ge 1000 ] && [ "$uid" -lt 65534 ] ||
        die "folders can only be shared by a normal user account"
    name="$(getent passwd "$uid" | cut -d: -f1)"
    [ -n "$name" ] || die "unknown user id $uid"
    printf '%s' "$name"
}

# check_path OWNER PATH -> prints the resolved folder, or explains why not.
check_path() {
    local owner="$1" path="$2" real home rest
    case "$path" in
        /*) ;;
        *) die "give the full path of the folder" ;;
    esac
    real="$(realpath -e -- "$path" 2>/dev/null)" || die "no such folder: $path"
    [ -d "$real" ] || die "not a folder: $real"
    # smb.conf would expand % and break on newlines or backslashes.
    if [[ "$real" == *[%\\]* ]] || [[ "$real" =~ [[:cntrl:]] ]]; then
        die "folder names with %, \\ or control characters cannot be shared"
    fi
    home="$(getent passwd "$owner" | cut -d: -f6)"
    if [ -n "$home" ] && [[ "$real" == "$home"/* ]]; then
        rest="${real#"$home"/}"
        if [[ "/$rest" == */.* ]]; then
            die "hidden folders (starting with a dot) cannot be shared"
        fi
    elif [[ "$real" == /mnt/shares || "$real" == /mnt/shares/* ]]; then
        die "network shares mounted from other computers cannot be shared again"
    elif [[ "$real" == /mnt/?* || "$real" == /media/?* || "$real" == /srv/?* ||
            "$real" == /run/media/"$owner"/?* ]]; then
        :
    else
        die "only folders inside your home folder, or on drives under /mnt, /media, /run/media or /srv, can be shared"
    fi
    runuser -u "$owner" -- test -r "$real" -a -x "$real" ||
        die "$owner cannot open $real, so it cannot be shared as $owner"
    printf '%s' "$real"
}

# read_share FILE: sets S_PATH S_OWNER S_GUEST S_RO without sourcing the file.
read_share() {
    S_PATH=""; S_OWNER=""; S_GUEST=0; S_RO=0
    local key value
    while IFS='=' read -r key value; do
        case "$key" in
            PATH_) S_PATH="$value" ;;
            OWNER) S_OWNER="$value" ;;
            GUEST) S_GUEST="$value" ;;
            RO) S_RO="$value" ;;
        esac
    done < "$1"
}

shares_exist() {
    compgen -G "$CONF_DIR/*.conf" >/dev/null
}

write_smb_conf() {
    local tmp conf name
    mkdir -p /etc/samba
    # Keep a smb.conf someone wrote by hand, once, before replacing it.
    if [ -f "$SMB_CONF" ] && ! grep -qF "$MARKER" "$SMB_CONF" && [ ! -e "$SMB_CONF.before-holtos" ]; then
        cp -p "$SMB_CONF" "$SMB_CONF.before-holtos"
    fi
    tmp="$(mktemp "$SMB_CONF.XXXXXX")"
    {
        echo "$MARKER — share folders in HoltOS' Network Shares, not here."
        cat <<'EOF'
[global]
   workgroup = WORKGROUP
   server string = HoltOS
   server role = standalone server
   server min protocol = SMB2_02
   # Only computers on the local network: private and link-local addresses.
   hosts allow = 127. 10. 172.16.0.0/12 192.168. 169.254. ::1 fe80::/10 fc00::/7
   hosts deny = ALL
   map to guest = Bad User
   guest account = nobody
   disable netbios = yes
   smb ports = 445
   multicast dns register = yes
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   usershare max shares = 0
   logging = systemd
   hide dot files = yes
   wide links = no
EOF
        for conf in "$CONF_DIR"/*.conf; do
            [ -f "$conf" ] || continue
            name="$(basename "$conf" .conf)"
            valid_name "$name" || continue
            read_share "$conf"
            [ -n "$S_PATH" ] && [ -n "$S_OWNER" ] || continue
            echo ""
            echo "[$name]"
            echo "   path = $S_PATH"
            echo "   comment = Shared by $S_OWNER"
            echo "   force user = $S_OWNER"
            echo "   read only = yes"
            if [ "$S_RO" != "1" ]; then
                echo "   write list = $S_OWNER"
            fi
            if [ "$S_GUEST" = "1" ]; then
                echo "   guest ok = yes"
            else
                echo "   guest ok = no"
                echo "   valid users = $S_OWNER"
            fi
            echo "   create mask = 0664"
            echo "   directory mask = 0775"
        done
    } > "$tmp"
    chmod 644 "$tmp"
    if ! testparm -s --suppress-prompt "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp"
        echo "the new Samba settings did not pass testparm; nothing was changed" >&2
        exit 1
    fi
    mv -f "$tmp" "$SMB_CONF"
}

apply_services() {
    [ -d /run/systemd/system ] || return 0
    if shares_exist; then
        systemctl enable wsdd.service smb.service >/dev/null 2>&1 || true
        if systemctl is-active --quiet smb.service; then
            systemctl reload smb.service
        else
            systemctl start smb.service
        fi
        systemctl start wsdd.service || true
    else
        systemctl disable --now smb.service wsdd.service >/dev/null 2>&1 || true
    fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
    list|status) ;;
    add|remove|password)
        [ "$(id -u)" -eq 0 ] || { echo "holtos-samba must run as root (pkexec)" >&2; exit 1; }
        command -v smbd >/dev/null || { echo "Samba is not installed" >&2; exit 1; }
        mkdir -p "$CONF_DIR" "$USERS_DIR"
        chmod 755 "$CONF_DIR" "$USERS_DIR"
        ;;
esac

case "$cmd" in
list)
    [ -d "$CONF_DIR" ] || exit 0
    for conf in "$CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        name="$(basename "$conf" .conf)"
        read_share "$conf"
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$S_PATH" "$S_OWNER" "$S_GUEST" "$S_RO"
    done
    ;;
status)
    if systemctl is-active --quiet smb.service 2>/dev/null; then echo running; else echo stopped; fi
    if [ -d "$USERS_DIR" ]; then
        for f in "$USERS_DIR"/*; do
            [ -f "$f" ] && basename "$f"
        done
    fi
    exit 0
    ;;
add)
    name="${1:-}"; path="${2:-}"
    [ -n "$name" ] && [ -n "$path" ] || die "usage: holtos-samba add NAME PATH [--guest] [--read-only]"
    shift 2
    guest=0; ro=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --guest) guest=1 ;;
            --read-only) ro=1 ;;
            *) die "unknown option $1" ;;
        esac
        shift
    done
    valid_name "$name" || die "bad share name: $name (up to 24 letters, digits, _ or -)"
    owner="$(owner_name)"
    real="$(check_path "$owner" "$path")"
    if [ -f "$CONF_DIR/$name.conf" ]; then
        read_share "$CONF_DIR/$name.conf"
        [ "$S_OWNER" = "$owner" ] || die "the share name $name is already used by $S_OWNER"
    fi
    tmp="$(mktemp "$CONF_DIR/.$name.XXXXXX")"
    printf 'PATH_=%s\nOWNER=%s\nGUEST=%s\nRO=%s\n' "$real" "$owner" "$guest" "$ro" > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$CONF_DIR/$name.conf"
    write_smb_conf
    apply_services
    echo "==> Sharing $real as \\\\$(cat /etc/hostname 2>/dev/null || hostname)\\$name"
    if [ ! -f "$USERS_DIR/$owner" ] && [ "$guest" = "0" ]; then
        echo "==> WARNING: set a network password so you can open this share from other computers"
    fi
    ;;
remove)
    name="${1:-}"
    valid_name "$name" || die "bad share name: $name"
    [ -f "$CONF_DIR/$name.conf" ] || die "no shared folder called $name"
    owner="$(owner_name)"
    read_share "$CONF_DIR/$name.conf"
    [ "$S_OWNER" = "$owner" ] || die "$name is shared by $S_OWNER; only they can stop sharing it"
    rm -f "$CONF_DIR/$name.conf"
    write_smb_conf
    apply_services
    echo "==> Stopped sharing $name"
    ;;
password)
    owner="$(owner_name)"
    IFS= read -r pass || true
    [ -n "$pass" ] || die "the password cannot be empty"
    [ -f "$SMB_CONF" ] || write_smb_conf
    if ! printf '%s\n%s\n' "$pass" "$pass" | smbpasswd -s -a "$owner" >/dev/null; then
        echo "setting the network password failed" >&2
        exit 1
    fi
    smbpasswd -e "$owner" >/dev/null
    : > "$USERS_DIR/$owner"
    chmod 644 "$USERS_DIR/$owner"
    echo "==> Network password set for $owner"
    ;;
*)
    sed -n '11,18p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
