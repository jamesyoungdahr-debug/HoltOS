#!/bin/bash
# Keeps an installed HoltOS in line with what its current release expects,
# beyond the files the config update syncs: packages a release depends on
# (a config update never installs packages, so a new HoltOS tool reaching an
# older install found its dependencies missing), and extras that belong only
# on specific hardware, installed only when that hardware is present.
#
#   holtos-system-extras check   list what is missing, one package per line;
#                                exit 0 when something is missing, 1 when not
#   holtos-system-extras apply   install what is missing (root)
#
# What a release expects lives in files the config update syncs, so a
# release can change it without changing this script:
#   /usr/share/holtos/required-packages   one package name per line
#   /usr/share/holtos/model-extras.conf   KEY=yes switches for model extras
set -uo pipefail

REQUIRED=/usr/share/holtos/required-packages
MODELS=/usr/share/holtos/model-extras.conf
Z13_PACKAGES="z13ctl-bin z13gui-bin"

model_enabled() {   # KEY
    grep -qx "$1=yes" "$MODELS" 2>/dev/null
}

missing_required() {
    local pkg
    [ -f "$REQUIRED" ] || return 0
    while read -r pkg; do
        pkg="${pkg%%#*}"
        pkg="${pkg//[[:space:]]/}"
        [ -n "$pkg" ] || continue
        [[ "$pkg" =~ ^[a-z0-9@._+-]+$ ]] || continue
        pacman -Q "$pkg" >/dev/null 2>&1 || echo "$pkg"
    done < "$REQUIRED"
}

# ASUS ROG Flow Z13 (2025, GZ302): its DMI product and board names carry
# GZ302 ("ROG Flow Z13 GZ302EA_GZ302EA"); the ASUS USB IDs z13ctl drives
# (0b05:18c6, 0b05:1a30) are the fallback.
is_asus_z13_2025() {
    local f
    for f in /sys/class/dmi/id/product_name /sys/class/dmi/id/board_name; do
        grep -q "GZ302" "$f" 2>/dev/null && return 0
    done
    for f in /sys/bus/usb/devices/*/idVendor; do
        [ "$(cat "$f" 2>/dev/null)" = "0b05" ] || continue
        case "$(cat "${f%idVendor}idProduct" 2>/dev/null)" in
            18c6|1a30) return 0 ;;
        esac
    done
    return 1
}

missing_z13() {
    local pkg
    model_enabled ASUS_Z13_2025 || return 0
    is_asus_z13_2025 || return 0
    for pkg in $Z13_PACKAGES; do
        pacman -Q "$pkg" >/dev/null 2>&1 || echo "$pkg"
    done
}

# Drivers for this machine's hardware (rules in
# /usr/share/holtos/hardware-drivers.conf, read by holtos-hardware). The
# installer installs them from the ISO; every update installs any that are
# missing, such as for an NVIDIA card fitted later, and they then update with
# the system (Liam, 2026-09-14: check the hardware and provide working
# drivers, not just NVIDIA).
HARDWARE_LOG=/var/lib/holtos/hardware.log
CMDLINE_EXTRA=/var/lib/holtos/kernel-cmdline-extra

missing_drivers() {
    [ -x /usr/local/bin/holtos-hardware ] || return 0
    /usr/local/bin/holtos-hardware missing 2>/dev/null | cut -f1
}

# After the NVIDIA driver is first installed on a running system: the same
# settings the installer writes, and the kernel option added to the existing
# boot entries (holtos-limine-sync.sh copies kernels but never rewrites the
# entries).
setup_nvidia() {
    local esp conf
    cat > /etc/modprobe.d/nvidia-drm.conf <<'EOF'
options nvidia_drm modeset=1
options nvidia_drm fbdev=1
EOF
    mkdir -p "$(dirname "$CMDLINE_EXTRA")"
    grep -qx 'nvidia_drm.modeset=1' "$CMDLINE_EXTRA" 2>/dev/null || echo 'nvidia_drm.modeset=1' >> "$CMDLINE_EXTRA"
    for esp in /boot/efi /efi /boot; do
        for conf in "$esp/EFI/limine/limine.conf" "$esp/EFI/BOOT/limine.conf"; do
            [ -f "$conf" ] || continue
            sed -i '/^[[:space:]]*cmdline:.*root=/{/nvidia_drm\.modeset=1/!s/$/ nvidia_drm.modeset=1/}' "$conf"
        done
    done
}

setup_drivers() {   # the driver packages just installed
    local installed=" $* "
    case "$installed" in
        *" nvidia-utils "*|*" nvidia-open-dkms "*) setup_nvidia ;;
    esac
    case "$installed" in
        *" thermald "*) systemctl enable --now thermald.service >/dev/null 2>&1 || true ;;
    esac
    # Kernel modules and firmware load at the next boot.
    case "$installed" in
        *" nvidia-open-dkms "*|*" broadcom-wl-dkms "*|*" sof-firmware "*)
            echo "new drivers were installed ($(echo "$*" | tr ' ' ','))" > /run/holtos-reboot-required
            echo "==> New drivers installed; restart to use them" ;;
    esac
}

# Only HoltOS wallpapers: the same pacman NoExtract rule the image ships,
# and removal of other packages' wallpapers already on the system (KDE's
# extra wallpapers, Breeze's "Next").
trim_wallpapers() {
    if ! grep -q '^NoExtract = usr/share/wallpapers/' /etc/pacman.conf; then
        sed -i '/^\[options\]/a NoExtract = usr/share/wallpapers/* !usr/share/wallpapers/HoltOS*' /etc/pacman.conf
    fi
    find /usr/share/wallpapers -mindepth 1 -maxdepth 1 ! -name 'HoltOS*' -exec rm -rf {} + 2>/dev/null || true
}

# Only HoltOS themes (neon rebrand, Liam 2026-09-14): pacman never unpacks the
# stock Kvantum themes, Breeze and Kvantum colour schemes, Breeze Dark/Light
# Plasma styles, or the stock SDDM and Plymouth themes, and copies already on
# the system are removed. Kept on purpose: Plasma's "default" style (the
# fallback for anything a theme does not draw), SDDM's breeze and Plymouth's
# text and details themes (fallbacks if the HoltOS ones fail), Breeze icons and
# cursors. Keep this list in sync with archiso/airootfs/root/customize_airootfs.sh.
THEME_NOEXTRACT='usr/share/Kvantum/Kv* usr/share/color-schemes/Kv* usr/share/color-schemes/Breeze* usr/share/plasma/desktoptheme/breeze-dark/* usr/share/plasma/desktoptheme/breeze-light/* usr/share/sddm/themes/elarun/* usr/share/sddm/themes/maldives/* usr/share/sddm/themes/maya/* usr/share/plymouth/themes/bgrt/* usr/share/plymouth/themes/fade-in/* usr/share/plymouth/themes/glow/* usr/share/plymouth/themes/script/* usr/share/plymouth/themes/solar/* usr/share/plymouth/themes/spinfinity/* usr/share/plymouth/themes/spinner/* usr/share/plymouth/themes/tribar/*'
trim_themes() {
    if ! grep -q '^NoExtract = usr/share/Kvantum/Kv' /etc/pacman.conf; then
        sed -i "/^\[options\]/a NoExtract = ${THEME_NOEXTRACT}" /etc/pacman.conf
    fi
    rm -rf /usr/share/Kvantum/Kv* /usr/share/color-schemes/Kv*.colors /usr/share/color-schemes/Breeze*.colors \
           /usr/share/plasma/desktoptheme/breeze-dark /usr/share/plasma/desktoptheme/breeze-light \
           /usr/share/sddm/themes/elarun /usr/share/sddm/themes/maldives /usr/share/sddm/themes/maya \
           /usr/share/plymouth/themes/bgrt /usr/share/plymouth/themes/fade-in /usr/share/plymouth/themes/glow \
           /usr/share/plymouth/themes/script /usr/share/plymouth/themes/solar /usr/share/plymouth/themes/spinfinity \
           /usr/share/plymouth/themes/spinner /usr/share/plymouth/themes/tribar 2>/dev/null || true
}

# The OS is called HoltOS everywhere (Liam, 2026-09-14: Steam's system info in
# Game Mode said "Arch Linux"). /etc/os-release is ours, but Arch's filesystem
# package ships /usr/lib/os-release and lsb-release ships /etc/lsb-release,
# both naming Arch Linux. Copy ours over them, and stop pacman from unpacking
# Arch's os-release again. /etc/lsb-release is a pacman backup file, so
# lsb-release updates leave our copy alone.
fix_os_identity() {
    if ! grep -q '^NoExtract = usr/lib/os-release' /etc/pacman.conf; then
        sed -i '/^\[options\]/a NoExtract = usr/lib/os-release' /etc/pacman.conf
    fi
    [ -f /etc/os-release ] && ! [ /etc/os-release -ef /usr/lib/os-release ] &&
        install -m 644 /etc/os-release /usr/lib/os-release
    . /etc/os-release
    printf 'DISTRIB_ID="%s"\nDISTRIB_RELEASE="%s"\nDISTRIB_DESCRIPTION="%s"\n' \
        "$NAME" "$VERSION_ID" "$PRETTY_NAME" > /etc/lsb-release
}

# Neon rebrand: the new otter logo ships as PNGs derived from the ComfyUI
# render. The updater copies new files but never deletes old ones, so the old
# hand-drawn SVGs stayed on installed systems, and icon lookups by name could
# still pick the old otter. Remove them and refresh the icon cache.
remove_old_logo() {
    local removed=0 f
    # Only once the new icons are in place; never leave a system with no logo.
    [ -e /usr/share/icons/hicolor/256x256/apps/holtos-logo.png ] || return 0
    # The Den's launcher asks for the icon "the-den", which was a copy of the
    # old SVG: give it the new mark before that copy goes.
    if [ -e /usr/share/icons/hicolor/scalable/apps/the-den.svg ] &&
       [ -e /usr/share/icons/hicolor/256x256/apps/holtos-logo.png ]; then
        install -Dm644 /usr/share/icons/hicolor/256x256/apps/holtos-logo.png \
            /usr/share/icons/hicolor/256x256/apps/the-den.png
    fi
    for f in /usr/share/icons/hicolor/scalable/apps/holtos-logo.svg \
             /usr/share/icons/hicolor/scalable/apps/the-den.svg \
             /etc/calamares/branding/holtos/logo-icon.svg \
             /etc/calamares/branding/holtos/logo-wide.svg; do
        if [ -e "$f" ]; then
            rm -f "$f" && removed=1
        fi
    done
    if [ "$removed" -eq 1 ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    fi
}

# "homelab" is now HoltOS everywhere (Liam, 2026-09-14). The update brings
# the renamed scripts and pacman hook but never deletes the old ones, and
# two copies of the kernel-update hook would sync the boot menu twice.
# Remove each old file only once its HoltOS replacement is in place.
remove_old_homelab_files() {
    local name old new
    for name in cleanup-live detect-hardware fix-mkinitcpio limine-install limine-sync limine-theme locate-airootfs; do
        old="/usr/local/bin/homelab-$name.sh"
        new="/usr/local/bin/holtos-$name.sh"
        [ -e "$old" ] && [ -x "$new" ] && rm -f "$old"
    done
    old=/etc/pacman.d/hooks/95-homelab-limine-sync.hook
    new=/etc/pacman.d/hooks/95-holtos-limine-sync.hook
    [ -e "$old" ] && [ -e "$new" ] && rm -f "$old"
    old=/usr/share/applications/homelab-install.desktop
    new=/usr/share/applications/holtos-install.desktop
    [ -e "$old" ] && [ -e "$new" ] && rm -f "$old"
    return 0
}

# Network Shares browses the LAN: once avahi and nss-mdns are installed (they
# are on the required list), start avahi and let .local names resolve, the
# same as a fresh install (customize_airootfs.sh).
enable_lan_discovery() {
    if pacman -Q avahi >/dev/null 2>&1; then
        systemctl enable --now avahi-daemon.service >/dev/null 2>&1 || true
    fi
    if pacman -Q nss-mdns >/dev/null 2>&1 && ! grep -q '^hosts:.*mdns' /etc/nsswitch.conf; then
        sed -i '/^hosts:/s/resolve/mdns_minimal [NOTFOUND=return] resolve/' /etc/nsswitch.conf
    fi
    return 0
}

case "${1:-}" in
check)
    missing="$(missing_required; missing_z13; missing_drivers)"
    [ -n "$missing" ] || exit 1
    echo "$missing"
    exit 0
    ;;
apply)
    if [ "$(id -u)" -ne 0 ]; then
        echo "holtos-system-extras apply must run as root" >&2
        exit 1
    fi
    trim_wallpapers
    trim_themes
    fix_os_identity
    remove_old_logo
    remove_old_homelab_files
    required="$(missing_required)"
    z13="$(missing_z13)"
    drivers="$(missing_drivers | tr '\n' ' ')"
    drivers="${drivers% }"
    [ -x /usr/local/bin/holtos-hardware ] && /usr/local/bin/holtos-hardware log "$HARDWARE_LOG" 2>/dev/null
    if [ -z "$required" ] && [ -z "$z13" ] && [ -z "$drivers" ]; then
        echo "==> No HoltOS components missing"
        enable_lan_discovery
        exit 0
    fi
    rc=0
    # A full -Syu with the new packages, never a bare -S: installing against
    # a refreshed database without upgrading is a partial upgrade on Arch.
    # shellcheck disable=SC2086
    if ! pacman -Syu --noconfirm --needed $required $z13 $drivers; then
        echo "==> Installing HoltOS components failed" >&2
        exit 1
    fi
    [ -n "$required" ] && echo "==> Installed packages this HoltOS release needs: $(echo $required)"
    if [ -n "$drivers" ]; then
        echo "==> Installed drivers for this machine's hardware: $drivers"
        # shellcheck disable=SC2086
        setup_drivers $drivers
    fi
    if [ -n "$z13" ]; then
        echo "==> ASUS ROG Flow Z13 (2025) detected; setting up its controls"
        z13ctl setup || { echo "==> WARNING: z13ctl setup failed; run 'sudo z13ctl setup' after a reboot" >&2; rc=1; }
        systemctl --global enable z13ctl.socket z13ctl.service z13gui.service >/dev/null 2>&1 || true
        # z13ctl grants device access to the users group.
        getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' | while read -r user; do
            usermod -aG users "$user"
        done
        echo "==> Z13 controls installed; log out and back in to start them"
    fi
    enable_lan_discovery
    exit "$rc"
    ;;
*)
    echo "Usage: holtos-system-extras check|apply" >&2
    exit 2
    ;;
esac
