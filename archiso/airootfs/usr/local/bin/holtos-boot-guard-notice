#!/bin/bash
# Autostarted on every login (etc/xdg/autostart). Does nothing unless
# holtos-boot-guard rolled back an update because the desktop did not start.
# Then it says so once per account: the note's time is remembered in
# ~/.local/state/holtos/rollback-seen.
NOTE=/var/log/holtos-boot-guard/rolled-back
SEEN="${XDG_STATE_HOME:-$HOME/.local/state}/holtos/rollback-seen"
ICON=/usr/share/icons/hicolor/256x256/apps/holtos-logo.png

[ -r "$NOTE" ] || exit 0
[ -e /run/archiso ] && exit 0
when="$(sed -n 's/^WHEN=//p' "$NOTE")"
snapshot="$(sed -n 's/^SNAPSHOT=//p' "$NOTE")"
[ -n "$when" ] || exit 0
[ "$(cat "$SEEN" 2>/dev/null)" = "$when" ] && exit 0

mkdir -p "$(dirname "$SEEN")"
printf '%s\n' "$when" > "$SEEN"

yad --title="HoltOS" --image="$ICON" --window-icon="$ICON" --width=540 --wrap \
    --text="<b>HoltOS undid the last update.</b>\n\nThe desktop did not start twice in a row after an update, so HoltOS went back to the snapshot taken just before it (${snapshot}). Your files in /home were not touched.\n\nThe system as it was before the rollback is kept as a snapshot too, so this can be undone from the tray (Restore Snapshot). HoltOS Updates will offer the update again; you can wait for a fixed one." \
    --button="OK:0"
exit 0
