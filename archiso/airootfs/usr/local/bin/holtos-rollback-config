#!/bin/bash
# Re-applies the config release before the currently-deployed one (see
# holtos-update-apply's rollback_config). Confirms first — this rewrites
# homelab-*.sh scripts back to an older version.
ICON=/usr/share/icons/hicolor/256x256/apps/holtos-logo.png

yad --title="HoltOS Updater" --image="$ICON" --window-icon="$ICON" \
    --text="Roll config back to the release before the current one?" \
    --button="Roll Back:0" --button="Cancel:1"
[ $? -eq 0 ] || exit 0

logfile="$(mktemp)"
pkexec /usr/local/bin/holtos-update-apply rollback 2>&1 | tee "$logfile" \
    | stdbuf -oL sed -u 's/^==> /#/' \
    | yad --progress --pulsate --auto-close --auto-kill \
        --title="HoltOS Updater" --image="$ICON" --window-icon="$ICON" \
        --text="Rolling back..." --width=420 --center \
        --no-buttons

status=${PIPESTATUS[0]}
if [ "$status" -ne 0 ]; then
    detail="$(tail -8 "$logfile")"
    yad --image=dialog-error --title="HoltOS Updater" --window-icon="$ICON" \
        --width=520 --wrap \
        --text="Rollback failed (exit $status):\n\n${detail}" \
        --button="Close:0"
else
    yad --image="$ICON" --title="HoltOS Updater" --window-icon="$ICON" \
        --text="Rollback complete." --button="Close:0"
fi
rm -f "$logfile"
