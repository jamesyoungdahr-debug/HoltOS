#!/bin/bash
# Checks for a new *tagged* HoltOS release only — never tracks raw branch
# commits. Only tags matching v* (e.g. v0.0.1-alpha) count, so in-progress
# work pushed to the repo never shows up as an "update" until it's actually
# released. No clone needed — `git ls-remote` alone is enough.
#
# Exit 0 + prints "<tag> <sha>" = update available.
# Exit 1 = already up to date, no tagged release exists yet, or the
# network/state file isn't available.
#
# The sha compared here MUST be the real commit sha, not an annotated tag
# object's own sha — see resolve_release()'s header in holtos-update-apply
# for the real bug this fixes (confirmed live against this repo's own
# v0.0.1-alpha tag, which is annotated): `--refs` alone returns the tag
# object sha, which never equals deployed-commit's real commit sha, so
# this used to report "update available" forever even when already
# current. Query without --refs and prefer the peeled (^{}) line instead.
set -euo pipefail

REPO_URL="https://github.com/jamesyoungdahr-debug/HoltOS.git"
STATE_FILE="/var/lib/holtos/deployed-commit"

raw="$(git ls-remote --tags --sort=-v:refname "$REPO_URL" 'v*' 2>/dev/null)"
[ -n "$raw" ] || exit 1

remote_tag="$(head -1 <<< "$raw" | cut -f2)"
remote_tag="${remote_tag%^\{\}}"
remote_tag="${remote_tag#refs/tags/}"
remote_sha="$(awk -F'\t' -v want="refs/tags/${remote_tag}^{}" '$2==want{print $1}' <<< "$raw")"
[ -n "$remote_sha" ] || remote_sha="$(awk -F'\t' -v want="refs/tags/${remote_tag}" '$2==want{print $1}' <<< "$raw")"
[ -n "$remote_sha" ] || exit 1
local_sha="$(cat "$STATE_FILE" 2>/dev/null || true)"

if [ "$remote_sha" != "$local_sha" ]; then
    echo "$remote_tag $remote_sha"
    exit 0
fi
exit 1
