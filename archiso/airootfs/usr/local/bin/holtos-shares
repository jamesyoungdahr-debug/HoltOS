#!/usr/bin/env python3
"""HoltOS Network Shares — the GUI half of holtos-share.

Lists the configured SMB/NFS shares with their mounted state and lets you
add, edit, remove, mount, unmount and open them. Everything that needs root
goes through `pkexec holtos-share ...` (one authentication prompt per
change), same pattern as the updater. Those calls run in the background, so
a slow or unreachable server never freezes the window. PySide6, like
holtos-tray, so it wears the HoltOS Glass theme like every other Qt window.
The "Add a network share" dialog can browse the local network (mDNS and
NetBIOS) for servers and their shares, without a password prompt. The
"Share from this computer" tab shares folders on this computer with the
local network through `pkexec holtos-samba`.
"""
import getpass
import os
import re
import socket
import subprocess
import sys

from PySide6.QtCore import QObject, QProcess, Qt, QTimer
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication, QCheckBox, QComboBox, QDialog, QDialogButtonBox, QFileDialog,
    QFormLayout, QHBoxLayout, QHeaderView, QLabel, QLineEdit, QListWidget,
    QListWidgetItem, QMainWindow, QMessageBox, QPushButton, QTableWidget,
    QTableWidgetItem, QVBoxLayout, QWidget, QTabWidget,
)

ICON_PATH = "/usr/share/icons/hicolor/256x256/apps/holtos-logo.png"
BACKEND = "/usr/local/bin/holtos-share"
SAMBA = "/usr/local/bin/holtos-samba"
MOUNT_ROOT = "/mnt/shares"
FIELDS = ["name", "type", "server", "path", "user", "ro", "auto", "mounted", "vers"]
SMB_VERSIONS = [
    ("auto", "Automatic (newest that works)"),
    ("3.1.1", "SMB 3.1.1"),
    ("3.0", "SMB 3.0"),
    ("2.1", "SMB 2.1"),
    ("2.0", "SMB 2.0"),
    ("1.0", "SMB 1.0 (old devices only)"),
]


def list_shares():
    # Listing is the backend's one unprivileged command (share metadata is
    # world-readable, credentials are not), so opening the window never
    # asks for a password.
    proc = subprocess.run([BACKEND, "list"], capture_output=True, text=True)
    if proc.returncode != 0:
        return None, (proc.stdout + proc.stderr).strip()
    rows = []
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) in (8, 9):
            row = dict(zip(FIELDS, parts))
            row.setdefault("vers", "")
            rows.append(row)
    return rows, ""


class BackendCall(QObject):
    """Runs `pkexec holtos-share ...` without blocking the window: a mount
    can take up to 30 seconds, and finding an SMB version longer."""

    def __init__(self, parent, args, stdin_text, on_done, program=BACKEND):
        super().__init__(parent)
        self.on_done = on_done
        self.done = False
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        self.process.finished.connect(self.finished)
        self.process.errorOccurred.connect(self.failed)
        self.process.start("pkexec", [program, *args])
        if stdin_text is not None:
            self.process.write(stdin_text.encode())
        self.process.closeWriteChannel()

    def finished(self, code, _status):
        if self.done:
            return
        self.done = True
        out = bytes(self.process.readAll()).decode(errors="replace").strip()
        self.on_done(code, out)
        self.deleteLater()

    def failed(self, error):
        if error == QProcess.FailedToStart and not self.done:
            self.done = True
            self.on_done(127, "Could not start pkexec.")
            self.deleteLater()


class LocalCall(QObject):
    """Runs `holtos-share ...` as the current user without blocking the
    window. Used for browsing (no root needed)."""

    def __init__(self, parent, args, stdin_text, on_done):
        super().__init__(parent)
        self.on_done = on_done
        self.done = False
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        self.process.finished.connect(self.finished)
        self.process.errorOccurred.connect(self.failed)
        self.process.start(BACKEND, list(args))
        if stdin_text is not None:
            self.process.write(stdin_text.encode())
        self.process.closeWriteChannel()

    def finished(self, code, _status):
        if self.done:
            return
        self.done = True
        out = bytes(self.process.readAll()).decode(errors="replace").strip()
        self.on_done(code, out)
        self.deleteLater()

    def failed(self, error):
        if error == QProcess.FailedToStart and not self.done:
            self.done = True
            self.on_done(127, "Could not start holtos-share.")
            self.deleteLater()


class BrowseDialog(QDialog):
    def __init__(self, parent, user, password):
        super().__init__(parent)
        self.setWindowTitle("Browse the network")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.setMinimumWidth(520)
        layout = QVBoxLayout(self)

        layout.addWidget(QLabel("Servers"))
        self.servers = QListWidget()
        layout.addWidget(self.servers)
        self.server_status = QLabel()
        self.server_status.setWordWrap(True)
        layout.addWidget(self.server_status)

        layout.addWidget(QLabel("Shares"))
        self.share_list = QListWidget()
        layout.addWidget(self.share_list)
        self.share_status = QLabel("Pick a server to see its shares.")
        self.share_status.setWordWrap(True)
        layout.addWidget(self.share_status)

        buttons = QDialogButtonBox()
        self.rescan_btn = buttons.addButton("Search again", QDialogButtonBox.ActionRole)
        self.ok_btn = buttons.addButton(QDialogButtonBox.Ok)
        self.ok_btn.setText("Use this share")
        self.ok_btn.setEnabled(False)
        buttons.addButton(QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        self.rescan_btn.clicked.connect(self.scan)
        layout.addWidget(buttons)

        self.user = user
        self.password = password
        self.request = 0
        self.kind = ""
        self.host = ""

        self.servers.currentItemChanged.connect(self.list_shares)
        self.share_list.currentItemChanged.connect(
            lambda cur, _prev: self.ok_btn.setEnabled(cur is not None))

        self.scan()

    def scan(self):
        # A share list still on its way belongs to the old results.
        self.request += 1
        self.servers.clear()
        self.share_list.clear()
        self.rescan_btn.setEnabled(False)
        self.server_status.setText("Looking for servers on your network...")
        LocalCall(self, ["browse"], None, self.scan_done)

    def scan_done(self, rc, out):
        self.rescan_btn.setEnabled(True)
        if rc != 0:
            self.server_status.setText(f"Could not search the network:\n{out}")
            return
        n = 0
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) != 4:
                continue
            kind, name, host, _addr = parts
            item = QListWidgetItem(
                f"{name}  ({host})  {'SMB' if kind == 'smb' else 'NFS'}")
            item.setData(Qt.UserRole, (kind, host))
            self.servers.addItem(item)
            n += 1
        if n == 0:
            self.server_status.setText(
                "No servers answered. You can still type the server's name or address.")
        else:
            self.server_status.setText(
                f"Found {n} server(s). Servers that do not announce themselves on "
                "the network will not appear here.")

    def list_shares(self, cur, _prev):
        self.share_list.clear()
        self.ok_btn.setEnabled(False)
        if cur is None:
            return
        self.kind, self.host = cur.data(Qt.UserRole)
        self.request += 1
        req = self.request
        self.share_status.setText(f"Asking {self.host} for its shares...")
        args = ["shares", self.kind, self.host]
        stdin = None
        if self.kind == "smb" and self.user:
            args.append(self.user)
            stdin = self.password
        LocalCall(self, args, stdin,
                  lambda rc, out, req=req: self.shares_done(req, rc, out))

    def shares_done(self, req, rc, out):
        if req != self.request:
            return
        if rc != 0:
            msg = f"Could not list the shares:\n{out}"
            if self.kind == "smb" and not self.user:
                msg += (
                    "\nIf the server needs a login, enter the username and password "
                    "in the previous window, then browse again.")
            self.share_status.setText(msg)
            return
        n = 0
        for line in out.splitlines():
            name, _, comment = line.partition("\t")
            if not name:
                continue
            text = name + (f"  -  {comment}" if comment else "")
            item = QListWidgetItem(text)
            item.setData(Qt.UserRole, name)
            self.share_list.addItem(item)
            n += 1
        if n == 0:
            self.share_status.setText("This server has no shares you can see.")
        else:
            self.share_status.setText(f"{n} share(s).")

    def choice(self):
        return (self.kind, self.host,
                self.share_list.currentItem().data(Qt.UserRole))


class ShareDialog(QDialog):
    def __init__(self, parent=None, share=None):
        super().__init__(parent)
        self.setWindowTitle("Edit share" if share else "Add a network share")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.setMinimumWidth(460)
        form = QFormLayout(self)

        self.name = QLineEdit(share["name"] if share else "")
        self.name.setPlaceholderText("media")
        self.name.setEnabled(share is None)
        self.type = QComboBox()
        self.type.addItem("Windows / Samba (SMB)", "smb")
        self.type.addItem("NFS", "nfs")
        if share:
            self.type.setCurrentIndex(0 if share["type"] == "smb" else 1)
        self.server = QLineEdit(share["server"] if share else "")
        self.server.setPlaceholderText("nas.local or 192.168.1.10")
        self.path = QLineEdit(share["path"] if share else "")
        self.user = QLineEdit(share["user"] if share else "")
        self.password = QLineEdit()
        self.password.setEchoMode(QLineEdit.Password)
        self.vers = QComboBox()
        for value, text in SMB_VERSIONS:
            self.vers.addItem(text, value)
        if share and share.get("vers"):
            index = self.vers.findData(share["vers"])
            if index >= 0:
                self.vers.setCurrentIndex(index)
        self.ro = QCheckBox("Read-only")
        self.ro.setChecked(bool(share and share["ro"] == "1"))
        self.auto = QCheckBox("Mount automatically (on first access, every boot)")
        self.auto.setChecked(not share or share["auto"] == "1")

        form.addRow("Name", self.name)
        form.addRow("Type", self.type)
        server_row = QHBoxLayout()
        server_row.addWidget(self.server)
        self.browse_btn = QPushButton("Browse...")
        self.browse_btn.clicked.connect(self.browse)
        server_row.addWidget(self.browse_btn)
        form.addRow("Server", server_row)
        self.path_label = QLabel("Share")
        form.addRow(self.path_label, self.path)
        self.user_label = QLabel("Username")
        form.addRow(self.user_label, self.user)
        self.pass_label = QLabel("Password")
        form.addRow(self.pass_label, self.password)
        self.vers_label = QLabel("SMB version")
        form.addRow(self.vers_label, self.vers)
        form.addRow("", self.ro)
        form.addRow("", self.auto)
        hint = QLabel(f"Mounted at {MOUNT_ROOT}/<name>. Leave the username empty for guest access. "
                      "If a server will not connect, try Automatic or an older SMB version.")
        hint.setWordWrap(True)
        hint.setStyleSheet("color: palette(mid);")
        form.addRow(hint)

        buttons = QDialogButtonBox()
        self.test_btn = buttons.addButton("Test connection", QDialogButtonBox.ActionRole)
        buttons.addButton(QDialogButtonBox.Ok).setText("Save")
        buttons.addButton(QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        self.test_btn.clicked.connect(self.test)
        form.addRow(buttons)
        self.type.currentIndexChanged.connect(self.update_labels)
        self.update_labels()

    def update_labels(self):
        smb = self.type.currentData() == "smb"
        self.path_label.setText("Share name" if smb else "Export path")
        self.path.setPlaceholderText("Media" if smb else "/export/media")
        for w in (self.user, self.password, self.user_label, self.pass_label, self.vers, self.vers_label):
            w.setVisible(smb)

    def browse(self):
        d = BrowseDialog(self, self.user.text().strip(), self.password.text())
        if d.exec() != QDialog.Accepted:
            return
        kind, host, share = d.choice()
        self.type.setCurrentIndex(0 if kind == "smb" else 1)
        self.server.setText(host)
        self.path.setText(share)
        if self.name.isEnabled() and not self.name.text().strip():
            safe = re.sub(r"[^A-Za-z0-9_.-]", "-", share).lstrip("-._")[:41] or "share"
            self.name.setText(safe)

    def values(self):
        smb = self.type.currentData() == "smb"
        return {
            "name": self.name.text().strip(),
            "type": self.type.currentData(),
            "server": self.server.text().strip(),
            "path": self.path.text().strip(),
            "user": self.user.text().strip() if smb else "",
            "password": self.password.text(),
            "vers": self.vers.currentData() if smb else "",
            "ro": self.ro.isChecked(),
            "auto": self.auto.isChecked(),
        }

    def validate(self):
        v = self.values()
        if not v["name"] or not v["server"] or not v["path"]:
            QMessageBox.warning(self, "Network Shares", "Name, server and share are required.")
            return None
        return v

    def test(self):
        v = self.validate()
        if not v:
            return
        args = ["test", v["type"], v["server"], v["path"]] + ([v["user"]] if v["user"] else [])
        if v["type"] == "smb":
            args += ["--vers", v["vers"]]
        self.test_btn.setEnabled(False)
        self.test_btn.setText("Testing...")
        BackendCall(self, args, v["password"] if v["user"] else None, self.test_done)

    def test_done(self, rc, out):
        self.test_btn.setEnabled(True)
        self.test_btn.setText("Test connection")
        if rc == 0:
            QMessageBox.information(self, "Network Shares", f"Connected.\n\n{out}")
        elif rc != 126:
            QMessageBox.critical(self, "Network Shares", f"Could not connect:\n\n{out}")

    def accept(self):
        if self.validate():
            super().accept()


class ShareFolderDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Share a folder")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.setMinimumWidth(480)
        form = QFormLayout(self)

        folder_row = QHBoxLayout()
        self.folder = QLineEdit()
        choose_btn = QPushButton("Choose...")
        choose_btn.clicked.connect(self.choose_folder)
        folder_row.addWidget(self.folder)
        folder_row.addWidget(choose_btn)
        form.addRow("Folder", folder_row)

        self.name = QLineEdit()
        self.name.setPlaceholderText("Media")
        form.addRow("Share name", self.name)

        self.guest = QCheckBox("Anyone on the network can open it (read-only)")
        form.addRow("", self.guest)

        self.read_only = QCheckBox("Read-only for me too")
        form.addRow("", self.read_only)

        hint = QLabel(
            "Only computers on your local network can connect. You open the share "
            "from another computer with your user name and network password."
        )
        hint.setWordWrap(True)
        hint.setStyleSheet("color: palette(mid);")
        form.addRow(hint)

        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        buttons.button(QDialogButtonBox.Ok).setText("Share")
        form.addRow(buttons)

    def choose_folder(self):
        path = QFileDialog.getExistingDirectory(
            self, "Choose a folder to share", os.path.expanduser("~")
        )
        if path:
            self.folder.setText(path)
            if not self.name.text().strip():
                base = os.path.basename(os.path.normpath(path))
                safe = re.sub(r"[^A-Za-z0-9_-]", "-", base).strip("-_")[:24] or "Shared"
                self.name.setText(safe)

    def values(self):
        return {
            "name": self.name.text().strip(),
            "folder": self.folder.text().strip(),
            "guest": self.guest.isChecked(),
            "read_only": self.read_only.isChecked(),
        }

    def accept(self):
        if not self.folder.text().strip() or not self.name.text().strip():
            QMessageBox.warning(
                self, "Network Shares", "Choose a folder and a share name."
            )
            return
        super().accept()


class PasswordDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Network password")
        form = QFormLayout(self)

        self.password1 = QLineEdit()
        self.password1.setEchoMode(QLineEdit.Password)
        form.addRow("Password", self.password1)

        self.password2 = QLineEdit()
        self.password2.setEchoMode(QLineEdit.Password)
        form.addRow("Repeat password", self.password2)

        hint = QLabel(
            "This is the password other computers ask for when they open your shares. "
            "It can differ from your login password."
        )
        hint.setWordWrap(True)
        form.addRow(hint)

        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        form.addRow(buttons)

    def password(self):
        return self.password1.text()

    def accept(self):
        if not self.password1.text():
            QMessageBox.warning(self, "Network Shares", "Enter a password.")
            return
        if self.password1.text() != self.password2.text():
            QMessageBox.warning(self, "Network Shares", "The passwords do not match.")
            return
        super().accept()


class HostPage(QWidget):
    def __init__(self, parent=None):
        super().__init__()
        layout = QVBoxLayout(self)

        host = socket.gethostname()
        intro = QLabel(
            f"Folders shared here open from other computers on your network as "
            f"\\\\{host}\\<name> on Windows, or smb://{host}.local/<name> on a Mac or Linux."
        )
        intro.setWordWrap(True)
        layout.addWidget(intro)

        self.state = QLabel()
        self.state.setWordWrap(True)
        layout.addWidget(self.state)

        self.table = QTableWidget(0, 3)
        self.table.setHorizontalHeaderLabels(["Name", "Folder", "Who can open it"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.setSelectionBehavior(QTableWidget.SelectRows)
        self.table.setSelectionMode(QTableWidget.SingleSelection)
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        layout.addWidget(self.table)

        row = QHBoxLayout()
        self.share_btn = QPushButton("Share a folder...")
        self.stop_btn = QPushButton("Stop sharing")
        self.password_btn = QPushButton("Set network password...")
        self.refresh_btn = QPushButton("Refresh")
        row.addWidget(self.share_btn)
        row.addWidget(self.stop_btn)
        row.addWidget(self.password_btn)
        row.addStretch()
        row.addWidget(self.refresh_btn)
        layout.addLayout(row)

        self.status = QLabel()
        self.status.setWordWrap(True)
        layout.addWidget(self.status)

        self.share_btn.clicked.connect(self.share)
        self.stop_btn.clicked.connect(self.stop)
        self.password_btn.clicked.connect(self.set_password)
        self.refresh_btn.clicked.connect(self.refresh)
        self.table.itemSelectionChanged.connect(self.update_buttons)

        self.rows = []
        self.busy = False
        QTimer.singleShot(0, self.refresh)

    def installed(self):
        return os.access(SAMBA, os.X_OK) and os.path.exists("/usr/bin/smbd")

    def refresh(self):
        if not self.installed():
            self.rows = []
            self.table.setRowCount(0)
            self.state.setText(
                "Sharing folders needs Samba, which arrives with the next HoltOS update."
            )
            self.update_buttons()
            return

        list_proc = subprocess.run([SAMBA, "list"], capture_output=True, text=True)
        status_proc = subprocess.run([SAMBA, "status"], capture_output=True, text=True)

        rows = []
        for line in list_proc.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) == 5:
                rows.append(parts)

        self.rows = rows

        status_lines = status_proc.stdout.strip().splitlines()
        first = status_lines[0] if status_lines else "stopped"
        users = status_lines[1:] if len(status_lines) > 1 else []
        me = getpass.getuser()

        state_parts = [
            "Sharing is on." if first == "running" else "Sharing is off until you share a folder.",
        ]
        if me in users:
            state_parts.append("Your network password is set.")
        else:
            state_parts.append(
                "Set a network password so you can open your shares from other computers."
            )
        self.state.setText(" ".join(state_parts))

        self.table.setRowCount(len(rows))
        for i, (name, path, owner, guest, readonly) in enumerate(rows):
            who = "You can read and change files" if readonly == "0" else "You can read files"
            if guest == "1":
                who += "; everyone else on the network can read them"
            if owner != me:
                who += f" (shared by {owner})"

            for j, v in enumerate([name, path, who]):
                item = QTableWidgetItem(v)
                item.setFlags(item.flags() & ~Qt.ItemIsEditable)
                self.table.setItem(i, j, item)

        self.update_buttons()

    def update_buttons(self):
        idle = not self.busy and self.installed()
        self.share_btn.setEnabled(idle)
        self.password_btn.setEnabled(idle)
        selected_row = self.table.currentRow()
        has_selection = 0 <= selected_row < len(self.rows)
        self.stop_btn.setEnabled(idle and has_selection)

    def run(self, args, stdin_text, busy_text, done):
        self.busy = True
        self.status.setText(busy_text)
        self.update_buttons()

        def finished(rc, out):
            self.busy = False
            self.status.setText("")
            done(rc, out)
            self.refresh()

        BackendCall(self, args, stdin_text, finished, program=SAMBA)

    def share(self):
        d = ShareFolderDialog(self)
        if d.exec() != QDialog.Accepted:
            return
        v = d.values()
        args = ["add", v["name"], v["folder"]]
        if v["guest"]:
            args.append("--guest")
        if v["read_only"]:
            args.append("--read-only")

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(
                    self, "Network Shares", f"Sharing the folder failed:\n\n{out}"
                )
            elif rc == 0 and "WARNING" in out:
                QMessageBox.information(
                    self, "Network Shares",
                    "The folder is shared. Set a network password so you can open it from other computers."
                )

        self.run(args, None, f"Sharing {v['folder']}...", done)

    def stop(self):
        r = self.table.currentRow()
        if not (0 <= r < len(self.rows)):
            return
        name = self.rows[r][0]
        if QMessageBox.question(
            self, "Network Shares",
            f'Stop sharing "{name}"?\n\nThe folder and its files stay on this computer.'
        ) != QMessageBox.Yes:
            return

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", out)

        self.run(["remove", name], None, f"Stopping {name}...", done)

    def set_password(self):
        d = PasswordDialog(self)
        if d.exec() != QDialog.Accepted:
            return

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(
                    self, "Network Shares", f"Setting the network password failed:\n\n{out}"
                )
            elif rc == 0:
                QMessageBox.information(self, "Network Shares", "Network password set.")

        self.run(["password"], d.password() + "\n", "Setting your network password...", done)


class SharesWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Network Shares")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.resize(800, 460)
        tabs = QTabWidget()
        self.setCentralWidget(tabs)
        central = QWidget()
        tabs.addTab(central, "Shares on other computers")
        layout = QVBoxLayout(central)

        intro = QLabel("Shares mount under /mnt/shares and appear in Dolphin. "
                       "Automatic shares mount on first access after every boot.")
        intro.setWordWrap(True)
        layout.addWidget(intro)

        self.table = QTableWidget(0, 6)
        self.table.setHorizontalHeaderLabels(["Name", "Type", "Server", "Share", "Automatic", "Status"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.setSelectionBehavior(QTableWidget.SelectRows)
        self.table.setSelectionMode(QTableWidget.SingleSelection)
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        layout.addWidget(self.table)

        row = QHBoxLayout()
        self.add_btn = QPushButton("Add...")
        self.edit_btn = QPushButton("Edit...")
        self.remove_btn = QPushButton("Remove")
        self.mount_btn = QPushButton("Mount")
        self.unmount_btn = QPushButton("Unmount")
        self.open_btn = QPushButton("Open")
        self.refresh_btn = QPushButton("Refresh")
        for b in (self.add_btn, self.edit_btn, self.remove_btn, self.mount_btn, self.unmount_btn, self.open_btn):
            row.addWidget(b)
        row.addStretch()
        row.addWidget(self.refresh_btn)
        layout.addLayout(row)

        self.status = QLabel()
        self.status.setWordWrap(True)
        layout.addWidget(self.status)

        self.add_btn.clicked.connect(self.add)
        self.edit_btn.clicked.connect(self.edit)
        self.remove_btn.clicked.connect(self.remove)
        self.mount_btn.clicked.connect(lambda: self.simple("mount"))
        self.unmount_btn.clicked.connect(lambda: self.simple("unmount"))
        self.open_btn.clicked.connect(self.open)
        self.refresh_btn.clicked.connect(self.refresh)
        self.table.itemSelectionChanged.connect(self.update_buttons)
        self.shares = []
        self.busy = False
        QTimer.singleShot(0, self.refresh)

        self.host_page = HostPage(self)
        tabs.addTab(self.host_page, "Share from this computer")

    def selected(self):
        r = self.table.currentRow()
        return self.shares[r] if 0 <= r < len(self.shares) else None

    def update_buttons(self):
        s = self.selected()
        idle = not self.busy
        self.add_btn.setEnabled(idle)
        for b in (self.edit_btn, self.remove_btn):
            b.setEnabled(idle and s is not None)
        self.open_btn.setEnabled(s is not None)
        self.mount_btn.setEnabled(idle and s is not None and s["mounted"] != "1")
        self.unmount_btn.setEnabled(idle and s is not None and s["mounted"] == "1")

    def refresh(self):
        rows, err = list_shares()
        if rows is None:
            self.shares = []
            self.table.setRowCount(0)
            if err and "dismissed" not in err.lower():
                QMessageBox.critical(self, "Network Shares", f"Could not read the share list:\n\n{err}")
            self.update_buttons()
            return
        self.shares = rows
        self.table.setRowCount(len(rows))
        for i, s in enumerate(rows):
            if s["type"] == "smb":
                kind = f"SMB {s['vers']}" if s.get("vers") else "SMB"
            else:
                kind = "NFS"
            vals = [s["name"], kind, s["server"], s["path"],
                    "yes" if s["auto"] == "1" else "no",
                    ("mounted" if s["mounted"] == "1" else "not mounted") + (" (read-only)" if s["ro"] == "1" else "")]
            for j, v in enumerate(vals):
                item = QTableWidgetItem(v)
                item.setFlags(item.flags() & ~Qt.ItemIsEditable)
                self.table.setItem(i, j, item)
        self.update_buttons()

    def run(self, args, stdin_text, busy_text, done):
        self.busy = True
        self.status.setText(busy_text)
        self.update_buttons()

        def finished(rc, out):
            self.busy = False
            self.status.setText("")
            done(rc, out)
            self.refresh()

        BackendCall(self, args, stdin_text, finished)

    def apply(self, v):
        args = ["add", v["name"], v["type"], v["server"], v["path"]]
        if v["user"]:
            args.append(v["user"])
        if v["ro"]:
            args.append("--ro")
        if not v["auto"]:
            args.append("--no-auto")
        if v["type"] == "smb":
            args += ["--vers", v["vers"]]
        busy_text = f"Saving {v['name']}..."
        if v["type"] == "smb" and v["vers"] == "auto":
            busy_text += " Finding an SMB version the server accepts (this can take a little while)."

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", f"Saving the share failed:\n\n{out}")
            elif rc == 0 and "WARNING" in out:
                QMessageBox.warning(self, "Network Shares", out)

        self.run(args, v["password"] if v["user"] else None, busy_text, done)

    def add(self):
        d = ShareDialog(self)
        if d.exec() == QDialog.Accepted:
            self.apply(d.values())

    def edit(self):
        s = self.selected()
        if not s:
            return
        d = ShareDialog(self, share=s)
        if d.exec() == QDialog.Accepted:
            v = d.values()
            if v["type"] == "smb" and v["user"] and not v["password"]:
                QMessageBox.information(self, "Network Shares", "Enter the password again to save an SMB share with a username.")
                return
            self.apply(v)

    def remove(self):
        s = self.selected()
        if not s:
            return
        if QMessageBox.question(self, "Network Shares", f"Remove the share \"{s['name']}\"?\n\nNothing on the server is touched.") != QMessageBox.Yes:
            return

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", out)

        self.run(["remove", s["name"]], None, f"Removing {s['name']}...", done)

    def simple(self, action):
        s = self.selected()
        if not s:
            return
        verb = "Mounting" if action == "mount" else "Unmounting"

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", f"{action.capitalize()} failed:\n\n{out}")

        self.run([action, s["name"]], None, f"{verb} {s['name']}...", done)

    def open(self):
        s = self.selected()
        if s:
            subprocess.Popen(["xdg-open", f"{MOUNT_ROOT}/{s['name']}"])


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("HoltOS Network Shares")
    app.setDesktopFileName("holtos-shares")
    w = SharesWindow()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
