#!/usr/bin/env python3
"""HoltOS Network Shares — the GUI half of holtos-share.

Lists the configured SMB/NFS shares with their mounted state and lets you
add, edit, remove, mount, unmount and open them. Everything that needs root
goes through `pkexec holtos-share ...` (one authentication prompt per
change), same pattern as the updater. Those calls run in the background, so
a slow or unreachable server never freezes the window. PySide6, like
holtos-tray, so it wears the HoltOS Glass theme like every other Qt window.
"""
import subprocess
import sys

from PySide6.QtCore import QObject, QProcess, Qt, QTimer
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication, QCheckBox, QComboBox, QDialog, QDialogButtonBox, QFormLayout,
    QHBoxLayout, QHeaderView, QLabel, QLineEdit, QMainWindow, QMessageBox,
    QPushButton, QTableWidget, QTableWidgetItem, QVBoxLayout, QWidget,
)

ICON_PATH = "/usr/share/icons/hicolor/256x256/apps/holtos-logo.png"
BACKEND = "/usr/local/bin/holtos-share"
MOUNT_ROOT = "/mnt/shares"
FIELDS = ["name", "type", "server", "path", "user", "ro", "auto", "mounted", "vers"]
SMB_VERSIONS = [
    ("auto", "Automatic (newest that works)"),
    ("3.1.1", "SMB 3.1.1"),
    ("3.0", "SMB 3.0"),
    ("2.1", "SMB 2.1"),
    ("2.0", "SMB 2.0"),
    ("1.0", "SMB 1.0 (old devices only)"),
]


def list_shares():
    # Listing is the backend's one unprivileged command (share metadata is
    # world-readable, credentials are not), so opening the window never
    # asks for a password.
    proc = subprocess.run([BACKEND, "list"], capture_output=True, text=True)
    if proc.returncode != 0:
        return None, (proc.stdout + proc.stderr).strip()
    rows = []
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) in (8, 9):
            row = dict(zip(FIELDS, parts))
            row.setdefault("vers", "")
            rows.append(row)
    return rows, ""


class BackendCall(QObject):
    """Runs `pkexec holtos-share ...` without blocking the window: a mount
    can take up to 30 seconds, and finding an SMB version longer."""

    def __init__(self, parent, args, stdin_text, on_done):
        super().__init__(parent)
        self.on_done = on_done
        self.done = False
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        self.process.finished.connect(self.finished)
        self.process.errorOccurred.connect(self.failed)
        self.process.start("pkexec", [BACKEND, *args])
        if stdin_text is not None:
            self.process.write(stdin_text.encode())
        self.process.closeWriteChannel()

    def finished(self, code, _status):
        if self.done:
            return
        self.done = True
        out = bytes(self.process.readAll()).decode(errors="replace").strip()
        self.on_done(code, out)
        self.deleteLater()

    def failed(self, error):
        if error == QProcess.FailedToStart and not self.done:
            self.done = True
            self.on_done(127, "Could not start pkexec.")
            self.deleteLater()


class ShareDialog(QDialog):
    def __init__(self, parent=None, share=None):
        super().__init__(parent)
        self.setWindowTitle("Edit share" if share else "Add a network share")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.setMinimumWidth(460)
        form = QFormLayout(self)

        self.name = QLineEdit(share["name"] if share else "")
        self.name.setPlaceholderText("media")
        self.name.setEnabled(share is None)
        self.type = QComboBox()
        self.type.addItem("Windows / Samba (SMB)", "smb")
        self.type.addItem("NFS", "nfs")
        if share:
            self.type.setCurrentIndex(0 if share["type"] == "smb" else 1)
        self.server = QLineEdit(share["server"] if share else "")
        self.server.setPlaceholderText("nas.local or 192.168.1.10")
        self.path = QLineEdit(share["path"] if share else "")
        self.user = QLineEdit(share["user"] if share else "")
        self.password = QLineEdit()
        self.password.setEchoMode(QLineEdit.Password)
        self.vers = QComboBox()
        for value, text in SMB_VERSIONS:
            self.vers.addItem(text, value)
        if share and share.get("vers"):
            index = self.vers.findData(share["vers"])
            if index >= 0:
                self.vers.setCurrentIndex(index)
        self.ro = QCheckBox("Read-only")
        self.ro.setChecked(bool(share and share["ro"] == "1"))
        self.auto = QCheckBox("Mount automatically (on first access, every boot)")
        self.auto.setChecked(not share or share["auto"] == "1")

        form.addRow("Name", self.name)
        form.addRow("Type", self.type)
        form.addRow("Server", self.server)
        self.path_label = QLabel("Share")
        form.addRow(self.path_label, self.path)
        self.user_label = QLabel("Username")
        form.addRow(self.user_label, self.user)
        self.pass_label = QLabel("Password")
        form.addRow(self.pass_label, self.password)
        self.vers_label = QLabel("SMB version")
        form.addRow(self.vers_label, self.vers)
        form.addRow("", self.ro)
        form.addRow("", self.auto)
        hint = QLabel(f"Mounted at {MOUNT_ROOT}/<name>. Leave the username empty for guest access. "
                      "If a server will not connect, try Automatic or an older SMB version.")
        hint.setWordWrap(True)
        hint.setStyleSheet("color: palette(mid);")
        form.addRow(hint)

        buttons = QDialogButtonBox()
        self.test_btn = buttons.addButton("Test connection", QDialogButtonBox.ActionRole)
        buttons.addButton(QDialogButtonBox.Ok).setText("Save")
        buttons.addButton(QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        self.test_btn.clicked.connect(self.test)
        form.addRow(buttons)
        self.type.currentIndexChanged.connect(self.update_labels)
        self.update_labels()

    def update_labels(self):
        smb = self.type.currentData() == "smb"
        self.path_label.setText("Share name" if smb else "Export path")
        self.path.setPlaceholderText("Media" if smb else "/export/media")
        for w in (self.user, self.password, self.user_label, self.pass_label, self.vers, self.vers_label):
            w.setVisible(smb)

    def values(self):
        smb = self.type.currentData() == "smb"
        return {
            "name": self.name.text().strip(),
            "type": self.type.currentData(),
            "server": self.server.text().strip(),
            "path": self.path.text().strip(),
            "user": self.user.text().strip() if smb else "",
            "password": self.password.text(),
            "vers": self.vers.currentData() if smb else "",
            "ro": self.ro.isChecked(),
            "auto": self.auto.isChecked(),
        }

    def validate(self):
        v = self.values()
        if not v["name"] or not v["server"] or not v["path"]:
            QMessageBox.warning(self, "Network Shares", "Name, server and share are required.")
            return None
        return v

    def test(self):
        v = self.validate()
        if not v:
            return
        args = ["test", v["type"], v["server"], v["path"]] + ([v["user"]] if v["user"] else [])
        if v["type"] == "smb":
            args += ["--vers", v["vers"]]
        self.test_btn.setEnabled(False)
        self.test_btn.setText("Testing...")
        BackendCall(self, args, v["password"] if v["user"] else None, self.test_done)

    def test_done(self, rc, out):
        self.test_btn.setEnabled(True)
        self.test_btn.setText("Test connection")
        if rc == 0:
            QMessageBox.information(self, "Network Shares", f"Connected.\n\n{out}")
        elif rc != 126:
            QMessageBox.critical(self, "Network Shares", f"Could not connect:\n\n{out}")

    def accept(self):
        if self.validate():
            super().accept()


class SharesWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Network Shares")
        self.setWindowIcon(QIcon(ICON_PATH))
        self.resize(760, 400)
        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)

        intro = QLabel("Shares mount under /mnt/shares and appear in Dolphin. "
                       "Automatic shares mount on first access after every boot.")
        intro.setWordWrap(True)
        layout.addWidget(intro)

        self.table = QTableWidget(0, 6)
        self.table.setHorizontalHeaderLabels(["Name", "Type", "Server", "Share", "Automatic", "Status"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.setSelectionBehavior(QTableWidget.SelectRows)
        self.table.setSelectionMode(QTableWidget.SingleSelection)
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        layout.addWidget(self.table)

        row = QHBoxLayout()
        self.add_btn = QPushButton("Add...")
        self.edit_btn = QPushButton("Edit...")
        self.remove_btn = QPushButton("Remove")
        self.mount_btn = QPushButton("Mount")
        self.unmount_btn = QPushButton("Unmount")
        self.open_btn = QPushButton("Open")
        self.refresh_btn = QPushButton("Refresh")
        for b in (self.add_btn, self.edit_btn, self.remove_btn, self.mount_btn, self.unmount_btn, self.open_btn):
            row.addWidget(b)
        row.addStretch()
        row.addWidget(self.refresh_btn)
        layout.addLayout(row)

        self.status = QLabel()
        self.status.setWordWrap(True)
        layout.addWidget(self.status)

        self.add_btn.clicked.connect(self.add)
        self.edit_btn.clicked.connect(self.edit)
        self.remove_btn.clicked.connect(self.remove)
        self.mount_btn.clicked.connect(lambda: self.simple("mount"))
        self.unmount_btn.clicked.connect(lambda: self.simple("unmount"))
        self.open_btn.clicked.connect(self.open)
        self.refresh_btn.clicked.connect(self.refresh)
        self.table.itemSelectionChanged.connect(self.update_buttons)
        self.shares = []
        self.busy = False
        QTimer.singleShot(0, self.refresh)

    def selected(self):
        r = self.table.currentRow()
        return self.shares[r] if 0 <= r < len(self.shares) else None

    def update_buttons(self):
        s = self.selected()
        idle = not self.busy
        self.add_btn.setEnabled(idle)
        for b in (self.edit_btn, self.remove_btn):
            b.setEnabled(idle and s is not None)
        self.open_btn.setEnabled(s is not None)
        self.mount_btn.setEnabled(idle and s is not None and s["mounted"] != "1")
        self.unmount_btn.setEnabled(idle and s is not None and s["mounted"] == "1")

    def refresh(self):
        rows, err = list_shares()
        if rows is None:
            self.shares = []
            self.table.setRowCount(0)
            if err and "dismissed" not in err.lower():
                QMessageBox.critical(self, "Network Shares", f"Could not read the share list:\n\n{err}")
            self.update_buttons()
            return
        self.shares = rows
        self.table.setRowCount(len(rows))
        for i, s in enumerate(rows):
            if s["type"] == "smb":
                kind = f"SMB {s['vers']}" if s.get("vers") else "SMB"
            else:
                kind = "NFS"
            vals = [s["name"], kind, s["server"], s["path"],
                    "yes" if s["auto"] == "1" else "no",
                    ("mounted" if s["mounted"] == "1" else "not mounted") + (" (read-only)" if s["ro"] == "1" else "")]
            for j, v in enumerate(vals):
                item = QTableWidgetItem(v)
                item.setFlags(item.flags() & ~Qt.ItemIsEditable)
                self.table.setItem(i, j, item)
        self.update_buttons()

    def run(self, args, stdin_text, busy_text, done):
        self.busy = True
        self.status.setText(busy_text)
        self.update_buttons()

        def finished(rc, out):
            self.busy = False
            self.status.setText("")
            done(rc, out)
            self.refresh()

        BackendCall(self, args, stdin_text, finished)

    def apply(self, v):
        args = ["add", v["name"], v["type"], v["server"], v["path"]]
        if v["user"]:
            args.append(v["user"])
        if v["ro"]:
            args.append("--ro")
        if not v["auto"]:
            args.append("--no-auto")
        if v["type"] == "smb":
            args += ["--vers", v["vers"]]
        busy_text = f"Saving {v['name']}..."
        if v["type"] == "smb" and v["vers"] == "auto":
            busy_text += " Finding an SMB version the server accepts (this can take a little while)."

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", f"Saving the share failed:\n\n{out}")
            elif rc == 0 and "WARNING" in out:
                QMessageBox.warning(self, "Network Shares", out)

        self.run(args, v["password"] if v["user"] else None, busy_text, done)

    def add(self):
        d = ShareDialog(self)
        if d.exec() == QDialog.Accepted:
            self.apply(d.values())

    def edit(self):
        s = self.selected()
        if not s:
            return
        d = ShareDialog(self, share=s)
        if d.exec() == QDialog.Accepted:
            v = d.values()
            if v["type"] == "smb" and v["user"] and not v["password"]:
                QMessageBox.information(self, "Network Shares", "Enter the password again to save an SMB share with a username.")
                return
            self.apply(v)

    def remove(self):
        s = self.selected()
        if not s:
            return
        if QMessageBox.question(self, "Network Shares", f"Remove the share \"{s['name']}\"?\n\nNothing on the server is touched.") != QMessageBox.Yes:
            return

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", out)

        self.run(["remove", s["name"]], None, f"Removing {s['name']}...", done)

    def simple(self, action):
        s = self.selected()
        if not s:
            return
        verb = "Mounting" if action == "mount" else "Unmounting"

        def done(rc, out):
            if rc not in (0, 126):
                QMessageBox.critical(self, "Network Shares", f"{action.capitalize()} failed:\n\n{out}")

        self.run([action, s["name"]], None, f"{verb} {s['name']}...", done)

    def open(self):
        s = self.selected()
        if s:
            subprocess.Popen(["xdg-open", f"{MOUNT_ROOT}/{s['name']}"])


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("HoltOS Network Shares")
    app.setDesktopFileName("holtos-shares")
    w = SharesWindow()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
