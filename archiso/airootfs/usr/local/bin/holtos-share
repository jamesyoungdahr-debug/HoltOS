#!/usr/bin/env bash
# Network shares for HoltOS (SMB/CIFS and NFS), the root half. The GUI
# (holtos-shares) calls this through pkexec. Each share is a small
# KEY=VALUE file in /etc/holtos/shares/<name>.conf plus, for SMB, a
# root-only credentials file; from those this script writes a systemd
# .mount + .automount pair under /etc/systemd/system, so the share mounts
# on first access (Dolphin, The Den, anything touching /mnt/shares/<name>),
# copes with the network coming up late, and never blocks boot.
#
#   holtos-share add    NAME TYPE SERVER PATH [USER] [--ro] [--no-auto] [--vers V] [--opts OPTS]
#                       (TYPE smb|nfs; SMB password read from stdin if USER given;
#                        V is auto|3.1.1|3.0|2.1|2.0|1.0, auto finds one that works)
#   holtos-share remove NAME
#   holtos-share list               one line per share: NAME TYPE SERVER PATH USER RO AUTO MOUNTED SMBVERS
#   holtos-share mount|unmount NAME
#   holtos-share test   TYPE SERVER PATH [USER] [--vers V]   (password on stdin) — try it once, no config
set -euo pipefail

CONF_DIR=/etc/holtos/shares
MOUNT_ROOT=/mnt/shares
UNIT_DIR=/etc/systemd/system
# Newest first. Servers disagree about which SMB dialects they accept: old
# NAS boxes only speak 1.0 or 2.0, some Windows and Samba setups refuse
# anything below 3.0, and without vers= the kernel only offers 2.1 to 3.1.1.
# A mount that picks one the server does not speak fails or hangs until it
# times out, so the version that works is found once and saved with the share.
SMB_VERSIONS="3.1.1 3.0 2.1 2.0 1.0"
PROBE_TIMEOUT=10

# `list` is the one read-only command and runs as any user: share metadata
# (.conf, mode 644) holds no secrets — SMB passwords live in the .cred
# files, mode 600 — so the GUI opens without an authentication prompt.
# Everything else changes the system and needs root.
if [ "${1:-}" != "list" ]; then
    [ "$(id -u)" -eq 0 ] || { echo "holtos-share must run as root (pkexec)" >&2; exit 1; }
    mkdir -p "$CONF_DIR" "$MOUNT_ROOT"
    chmod 755 "$CONF_DIR"
fi

# Files land owned by the desktop user that asked (pkexec tells us), so
# SMB shares are writable by that user rather than by root only.
OWNER_UID="${PKEXEC_UID:-$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $3; exit }')}"
OWNER_UID="${OWNER_UID:-1000}"
OWNER_GID="$(getent passwd "$OWNER_UID" | cut -d: -f4)"
OWNER_GID="${OWNER_GID:-$OWNER_UID}"

valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,40}$ ]]; }
valid_vers() { case "$1" in auto|3.1.1|3.0|2.1|2.0|1.0) return 0 ;; *) return 1 ;; esac; }
unit_base() { systemd-escape --path "${MOUNT_ROOT}/$1"; }

mount_what() {   # TYPE SERVER PATH
    case "$1" in
        smb) printf '//%s/%s' "$2" "${3#/}" ;;
        nfs) printf '%s:%s' "$2" "$3" ;;
        *) echo "unknown share type: $1" >&2; return 1 ;;
    esac
}
mount_opts() {   # TYPE NAME RO EXTRA SMBVERS
    local opts
    case "$1" in
        smb)
            opts="credentials=${CONF_DIR}/$2.cred,uid=${OWNER_UID},gid=${OWNER_GID},file_mode=0664,dir_mode=0775,iocharset=utf8,nofail,_netdev"
            if [ -n "${5:-}" ] && [ "$5" != "auto" ]; then
                opts="${opts},vers=$5"
            fi
            ;;
        nfs) opts="nofail,_netdev,soft,timeo=100,retrans=3" ;;
    esac
    [ "$3" = "1" ] && opts="ro,${opts}"
    [ -n "${4:-}" ] && opts="${opts},$4"
    printf '%s' "$opts"
}
fs_type() { case "$1" in smb) echo cifs ;; nfs) echo nfs ;; esac; }

# probe_smb_version SERVER PATH CREDFILE — prints the newest SMB dialect the
# server accepts for this share, trying each for PROBE_TIMEOUT seconds.
probe_smb_version() {
    local server="$1" path="$2" cred="$3" tmp v
    tmp="$(mktemp -d)"
    for v in $SMB_VERSIONS; do
        if timeout "$PROBE_TIMEOUT" mount -t cifs -o "credentials=${cred},ro,vers=${v}" "$(mount_what smb "$server" "$path")" "$tmp" >/dev/null 2>&1; then
            umount "$tmp" 2>/dev/null || umount -l "$tmp" 2>/dev/null || true
            rmdir "$tmp" 2>/dev/null || true
            printf '%s' "$v"
            return 0
        fi
    done
    rmdir "$tmp" 2>/dev/null || true
    return 1
}

write_units() {   # NAME
    local name="$1" conf="${CONF_DIR}/$1.conf" base what opts
    # shellcheck disable=SC1090
    . "$conf"
    base="$(unit_base "$name")"
    what="$(mount_what "$TYPE" "$SERVER" "$PATH_")"
    opts="$(mount_opts "$TYPE" "$name" "${RO:-0}" "${OPTS:-}" "${SMBVERS:-}")"
    mkdir -p "${MOUNT_ROOT}/${name}"
    cat > "${UNIT_DIR}/${base}.mount" <<EOF
# Generated by holtos-share — edit the share in HoltOS' Network Shares, not here.
[Unit]
Description=HoltOS share: ${name} (${TYPE} ${what})
After=network-online.target
Wants=network-online.target

[Mount]
What=${what}
Where=${MOUNT_ROOT}/${name}
Type=$(fs_type "$TYPE")
Options=${opts}
TimeoutSec=30
EOF
    cat > "${UNIT_DIR}/${base}.automount" <<EOF
# Generated by holtos-share — edit the share in HoltOS' Network Shares, not here.
[Unit]
Description=HoltOS share: ${name} (automount)

[Automount]
Where=${MOUNT_ROOT}/${name}
TimeoutIdleSec=600

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    if [ "${AUTO:-1}" = "1" ]; then
        systemctl enable --now "${base}.automount" >/dev/null
    else
        systemctl disable --now "${base}.automount" >/dev/null 2>&1 || true
    fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
add)
    name="${1:?NAME}"; type="${2:?TYPE}"; server="${3:?SERVER}"; path="${4:?PATH}"; shift 4
    user=""; ro=0; auto=1; extra=""; vers=auto
    while [ $# -gt 0 ]; do
        case "$1" in
            --ro) ro=1 ;;
            --no-auto) auto=0 ;;
            --vers) vers="${2:-}"; shift ;;
            --opts) extra="${2:-}"; shift ;;
            --*) echo "unknown option $1" >&2; exit 2 ;;
            *) user="$1" ;;
        esac
        shift
    done
    valid_name "$name" || { echo "bad share name: $name (letters, digits, . _ -)" >&2; exit 2; }
    case "$type" in smb|nfs) ;; *) echo "TYPE must be smb or nfs" >&2; exit 2 ;; esac
    valid_vers "$vers" || { echo "bad SMB version: $vers (auto, 3.1.1, 3.0, 2.1, 2.0 or 1.0)" >&2; exit 2; }
    # Was this share mounted before (an edit)? Unmount so the new units apply.
    base="$(unit_base "$name")"
    systemctl stop "${base}.automount" "${base}.mount" >/dev/null 2>&1 || true
    if [ "$type" = "smb" ]; then
        if [ -n "$user" ]; then
            pass="$(cat)"
            printf 'username=%s\npassword=%s\n' "$user" "$pass" > "${CONF_DIR}/${name}.cred"
        else
            printf 'username=guest\npassword=\n' > "${CONF_DIR}/${name}.cred"
        fi
        chmod 600 "${CONF_DIR}/${name}.cred"
        if [ "$vers" = "auto" ]; then
            if found="$(probe_smb_version "$server" "$path" "${CONF_DIR}/${name}.cred")"; then
                vers="$found"
                echo "==> ${server} accepted SMB ${vers}"
            else
                echo "==> WARNING: could not connect to //${server}/${path#/} with any SMB version (3.1.1 down to 1.0); saved without a fixed version" >&2
            fi
        fi
    else
        vers=""
    fi
    {
        echo "TYPE=$type"; echo "SERVER=$server"; echo "PATH_=$path"
        echo "USER_=$user"; echo "RO=$ro"; echo "AUTO=$auto"; echo "OPTS=$extra"
        echo "SMBVERS=$vers"
    } > "${CONF_DIR}/${name}.conf"
    chmod 644 "${CONF_DIR}/${name}.conf"
    write_units "$name"
    echo "==> Share ${name} configured at ${MOUNT_ROOT}/${name}"
    ;;
remove)
    name="${1:?NAME}"; valid_name "$name" || exit 2
    base="$(unit_base "$name")"
    systemctl disable --now "${base}.automount" >/dev/null 2>&1 || true
    systemctl stop "${base}.mount" >/dev/null 2>&1 || true
    rm -f "${UNIT_DIR}/${base}.mount" "${UNIT_DIR}/${base}.automount" "${CONF_DIR}/${name}.conf" "${CONF_DIR}/${name}.cred"
    systemctl daemon-reload
    rmdir "${MOUNT_ROOT}/${name}" 2>/dev/null || true
    echo "==> Share ${name} removed"
    ;;
list)
    shopt -s nullglob
    [ -d "$CONF_DIR" ] || exit 0
    for conf in "$CONF_DIR"/*.conf; do
        name="$(basename "$conf" .conf)"
        # shellcheck disable=SC1090
        ( . "$conf"; mounted=0; mountpoint -q "${MOUNT_ROOT}/${name}" && findmnt -no FSTYPE "${MOUNT_ROOT}/${name}" | grep -qv autofs && mounted=1
          printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$TYPE" "$SERVER" "$PATH_" "${USER_:-}" "${RO:-0}" "${AUTO:-1}" "$mounted" "${SMBVERS:-}" )
    done
    ;;
mount)
    name="${1:?NAME}"; valid_name "$name" || exit 2
    base="$(unit_base "$name")"
    systemctl start "${base}.mount" && echo "==> ${name} mounted at ${MOUNT_ROOT}/${name}"
    ;;
unmount)
    name="${1:?NAME}"; valid_name "$name" || exit 2
    base="$(unit_base "$name")"
    systemctl stop "${base}.mount" && echo "==> ${name} unmounted"
    ;;
test)
    type="${1:?TYPE}"; server="${2:?SERVER}"; path="${3:?PATH}"; shift 3
    user=""; vers=auto
    while [ $# -gt 0 ]; do
        case "$1" in
            --vers) vers="${2:-}"; shift ;;
            --*) echo "unknown option $1" >&2; exit 2 ;;
            *) user="$1" ;;
        esac
        shift
    done
    valid_vers "$vers" || { echo "bad SMB version: $vers (auto, 3.1.1, 3.0, 2.1, 2.0 or 1.0)" >&2; exit 2; }
    tmp="$(mktemp -d)"
    rc=1
    if [ "$type" = "smb" ]; then
        cred="$(mktemp)"; chmod 600 "$cred"
        if [ -n "$user" ]; then printf 'username=%s\npassword=%s\n' "$user" "$(cat)" > "$cred"; else printf 'username=guest\npassword=\n' > "$cred"; fi
        if [ "$vers" = "auto" ]; then candidates="$SMB_VERSIONS"; else candidates="$vers"; fi
        for v in $candidates; do
            if out="$(timeout "$PROBE_TIMEOUT" mount -t cifs -o "credentials=${cred},ro,vers=${v}" "$(mount_what smb "$server" "$path")" "$tmp" 2>&1)"; then
                echo "==> OK over SMB ${v}: $(ls "$tmp" | wc -l) entries visible"
                umount "$tmp" 2>/dev/null || umount -l "$tmp" 2>/dev/null || true
                rc=0
                break
            fi
            echo "SMB ${v}: ${out:-no answer within ${PROBE_TIMEOUT}s}"
        done
        rm -f "$cred"
    else
        if timeout 20 mount -t nfs -o "ro,soft,timeo=50,retrans=1" "$(mount_what nfs "$server" "$path")" "$tmp" 2>&1; then
            echo "==> OK: $(ls "$tmp" | wc -l) entries visible"; umount "$tmp"; rc=0
        fi
    fi
    rmdir "$tmp" 2>/dev/null || true
    exit "$rc"
    ;;
*)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
