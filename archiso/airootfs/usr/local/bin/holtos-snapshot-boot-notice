#!/bin/bash
# Autostarted on every login (etc/xdg/autostart). Does nothing on a normal
# boot. When the session is running from a snapshot entry of the Limine
# menu (read-only rescue root), it says so and offers to make that
# snapshot the system — the "I broke it, go back" path in one click.
ICON=/usr/share/icons/hicolor/scalable/apps/holtos-logo.svg

src="$(findmnt -no SOURCE / 2>/dev/null)"
case "$src" in
    *"[/@snapshots/"*) ;;
    *) exit 0 ;;
esac
name="${src#*[/@snapshots/}"; name="${name%]}"

yad --question --title="HoltOS" --image="$ICON" --window-icon="$ICON" --width=520 --wrap \
    --text="<b>You are running from snapshot ${name}.</b>\n\nThis is a read-only rescue copy of the system. You can look around, or restore it as the system so the next normal boot runs this state (files in /home are kept)." \
    --button="Restore this snapshot:0" --button="Just look around:1"
[ $? -eq 0 ] || exit 0

logfile="$(mktemp)"
pkexec /usr/local/bin/holtos-btrfs-restore --current 2>&1 | tee "$logfile" \
    | stdbuf -oL sed -u 's/^==> /#/' \
    | yad --progress --pulsate --auto-close --auto-kill \
        --title="HoltOS" --image="$ICON" --window-icon="$ICON" \
        --text="Restoring snapshot..." --width=420 --center --no-buttons
status=${PIPESTATUS[0]}
if [ "$status" -ne 0 ]; then
    yad --image=dialog-error --title="HoltOS" --window-icon="$ICON" --width=520 --wrap \
        --text="Restore failed (exit $status):\n\n$(tail -8 "$logfile")" --button="Close:0"
    rm -f "$logfile"; exit "$status"
fi
rm -f "$logfile"
yad --question --title="HoltOS" --image="$ICON" --window-icon="$ICON" \
    --text="Snapshot restored. Reboot now into it?" --button="Reboot:0" --button="Later:1"
[ $? -eq 0 ] && systemctl reboot
exit 0
