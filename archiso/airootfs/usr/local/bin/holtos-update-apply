#!/bin/bash
# Applies updates for the specific items named on argv, run as root (the
# tray's holtos-update-picker launches this via a single pkexec call so
# picking several items only prompts for a password once). Each arg is one
# of: "config" (the homelab-*.sh install/boot scripts), "the-den" /
# "the-den-client" (companion apps, separately-maintained repos — see
# below), "rollback" (re-applies the config release before the
# currently-deployed one), or "system" (plain `pacman -Syu`, for the
# kernel/OS packages no git repo has anything to do with).
#
# (The per-service `podman pull` items and the Authentik pair are gone
# along with the container stack itself — 2026-09-11, see PLAN.md.)
#
# config/the-den/the-den-client are all gated on the latest *tagged*
# release of their own repo, downloaded as a GitHub release tarball (no
# `git clone`, no history) — never raw commits, so in-progress upstream
# work never lands on a running system.
#
# Every applied item is appended to /var/lib/holtos/history.log (world-
# readable — see holtos-update-history) as a small audit trail, and it's
# what rollback reads to find "the release before this one".
#
# config/system also take a Btrfs snapshot (holtos-btrfs-snapshot) right
# before touching anything — a full-filesystem, boot-from-Limine safety
# net independent of the tag-based rollback above (that one undoes to a
# specific *release*; the snapshot recovers from "something broke the box"
# more generally, including a bad kernel from a `system` update).
set -euo pipefail

HISTORY=/var/lib/holtos/history.log

log_history() {
    mkdir -p "$(dirname "$HISTORY")"
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" >> "$HISTORY"
    chmod 644 "$HISTORY"
}

# resolve_release <owner/repo> [target_tag] — prints "<commit>\t<tag>" for
# either the latest v* tag (no target_tag given) or that exact tag
# (verifying it actually exists on the remote). Returns 1 if nothing found.
#
# Real bug found in code review: `git ls-remote --refs` on an ANNOTATED tag
# (what GitHub's own "Create a release" UI creates — confirmed against this
# repo's own v0.0.1-alpha: `git ls-remote --tags` shows a
# `refs/tags/v0.0.1-alpha^{}` peeled line with a DIFFERENT sha from the
# plain ref) returns the tag OBJECT's own sha, not the commit it points to.
# holtos-update-check compares that against a real commit sha (deployed-
# commit, seeded from `git rev-parse HEAD` by build.sh and updated below) —
# they'd never match even when already up to date, so the tray's
# background check would report "update available" forever. Fix: query
# without --refs and explicitly prefer the peeled (^{}) line, which holds
# the real commit sha; lightweight tags have no peeled line, so the plain
# ref sha (already the commit sha) is used for those unchanged.
resolve_release() {
    local repo="$1" target_tag="${2:-}" url="https://github.com/$1.git" raw tag sha
    if [ -z "$target_tag" ]; then
        raw="$(git ls-remote --tags --sort=-v:refname "$url" 'v*' 2>/dev/null)"
        [ -n "$raw" ] || return 1
        tag="$(head -1 <<< "$raw" | cut -f2)"
        tag="${tag%^\{\}}"
        tag="${tag#refs/tags/}"
    else
        raw="$(git ls-remote --tags "$url" "refs/tags/$target_tag" "refs/tags/$target_tag^{}" 2>/dev/null)"
        [ -n "$raw" ] || return 1
        tag="$target_tag"
    fi
    sha="$(awk -F'\t' -v want="refs/tags/${tag}^{}" '$2==want{print $1}' <<< "$raw")"
    [ -n "$sha" ] || sha="$(awk -F'\t' -v want="refs/tags/${tag}" '$2==want{print $1}' <<< "$raw")"
    [ -n "$sha" ] || return 1
    printf '%s\t%s\n' "$sha" "$tag"
}

# download_release <owner/repo> <tag> <dest_dir> — extracts the tag's
# source tarball into dest_dir (must already exist).
download_release() {
    local repo="$1" tag="$2" dest="$3" tmp_tar
    tmp_tar="$(mktemp)"
    curl -fsSL "https://github.com/$repo/archive/refs/tags/${tag}.tar.gz" -o "$tmp_tar"
    tar -xzf "$tmp_tar" -C "$dest" --strip-components=1
    rm -f "$tmp_tar"
}

# update_config [target_tag] — with no argument, updates to the latest
# tagged release found on the remote. With an argument, updates to exactly
# that tag (used by rollback_config).
update_config() {
    local target_tag="${1:-}"
    local repo="jamesyoungdahr-debug/HoltOS"
    local state="/var/lib/holtos/deployed-commit"
    local new_commit latest_tag src_dir
    mkdir -p "$(dirname "$state")"

    echo "==> Looking up the release..."
    if ! IFS=$'\t' read -r new_commit latest_tag < <(resolve_release "$repo" "$target_tag"); then
        echo "No tagged HoltOS release found${target_tag:+ ($target_tag)}." >&2
        return 1
    fi

    # Best-effort, and only once we know there's actually something to
    # apply — a missing/failed snapshot shouldn't block the real update
    # (e.g. holtos-btrfs-snapshot assumes the Btrfs root layout from
    # etc/calamares/modules/{partition,mount}.conf, which only a fresh
    # install has).
    /usr/local/bin/holtos-btrfs-snapshot config || echo "==> WARNING: pre-update snapshot failed, continuing without one" >&2

    echo "==> Downloading $latest_tag..."
    src_dir="$(mktemp -d)"
    download_release "$repo" "$latest_tag" "$src_dir"

    # Every HoltOS-owned component comes from the release tarball — never
    # fetched ad hoc from Arch (Liam, 2026-09-12: "we shouldn't be
    # updating from any Arch sources but our own"). This is the whitelist
    # of what HoltOS owns on an installed system; installer-only files
    # (Calamares, live-session units, polkit rules) and Arch-owned config
    # are deliberately absent. Paths are relative to the tarball's
    # archiso/airootfs and land at the same path under /.
    echo "==> Syncing HoltOS components from $latest_tag..."
    local airootfs="$src_dir/archiso/airootfs"
    local components=(
        usr/local/bin/holtos-*
        usr/local/bin/homelab-*.sh
        etc/systemd/system/holtos-*.service
        etc/xdg/autostart/holtos-*.desktop
        usr/share/applications/holtos-*.desktop
        etc/xdg/kwinrc
        etc/xdg/kcm-about-distrorc
        etc/xdg/ksplashrc
        etc/os-release
        etc/pacman.d/hooks/*homelab*.hook
        etc/sddm.conf.d/holtos.conf
        etc/plymouth/plymouthd.conf
        etc/systemd/zram-generator.conf
        etc/skel/.config/
        usr/share/holtos/
        usr/share/Kvantum/HoltOSGlass/
        usr/share/color-schemes/
        usr/share/icons/hicolor/
        usr/share/konsole/
        usr/share/plasma/look-and-feel/
        usr/share/plymouth/themes/
        usr/share/sddm/themes/
        usr/share/wallpapers/HoltOS/
        usr/share/wallpapers/HoltOS-Otter/
        usr/local/bin/steamos-session-select
        usr/share/wayland-sessions/holtos-*.desktop
        etc/polkit-1/rules.d/*holtos*.rules
    )
    local present=()
    shopt -s nullglob
    ( cd "$airootfs" && for p in "${components[@]}"; do for m in $p; do echo "$m"; done; done ) > "$src_dir/components.list"
    shopt -u nullglob
    mapfile -t present < "$src_dir/components.list"
    if [ "${#present[@]}" -eq 0 ]; then
        echo "Release tarball has no HoltOS components — refusing to apply" >&2
        rm -rf "$src_dir"
        return 1
    fi
    ( cd "$airootfs" && rsync -aR --itemize-changes "${present[@]}" / ) | grep -E '^[<>c]' | sed 's/^/    /' || true
    chmod +x /usr/local/bin/holtos-* /usr/local/bin/homelab-*.sh 2>/dev/null || true
    rm -rf "$src_dir"

    # New units in this release start working on the next boot.
    echo "==> Reloading systemd and enabling new HoltOS units..."
    systemctl daemon-reload
    local unit
    for unit in /etc/systemd/system/holtos-*.service; do
        [ -f "$unit" ] || continue
        grep -q '^\[Install\]' "$unit" || continue
        systemctl enable "$(basename "$unit")" >/dev/null 2>&1 || true
    done

    # Our own package repository, so HoltOS-built packages (the glass
    # forks, Calamares, Limine tools) update through pacman from HoltOS'
    # releases rather than only existing at image-build time. Older
    # installs have the section with only the build-time file:// server.
    # [multilib] for installs that predate the gaming base (Steam, lib32).
    if grep -q '^#\[multilib\]' /etc/pacman.conf; then
        echo "==> Enabling [multilib] in pacman.conf..."
        sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' /etc/pacman.conf
    fi
    if ! grep -q '^\[homelab\]' /etc/pacman.conf; then
        echo "==> Adding the HoltOS package repository to pacman.conf..."
        cat /usr/share/holtos/pacman-homelab.conf >> /etc/pacman.conf
    elif ! grep -q 'releases/download/packages' /etc/pacman.conf; then
        echo "==> Adding the HoltOS package repository server to pacman.conf..."
        sed -i '/^\[homelab\]/,/^\[/{s|^\(Server = .*\)$|\1\nServer = https://github.com/jamesyoungdahr-debug/holtos/releases/download/packages|}' /etc/pacman.conf
    fi

    # Boot menu: theme, other operating systems, snapshot submenu — all
    # regenerated from what is on disk now (best-effort, a bootloader
    # cosmetic must never fail an update).
    echo "==> Refreshing the boot menu..."
    /usr/local/bin/homelab-limine-theme.sh 2>&1 | sed 's/^/    /' || true
    /usr/local/bin/holtos-limine-other-os 2>&1 | grep -E '^==>' | sed 's/^/    /' || true
    /usr/local/bin/holtos-btrfs-snapshot --regen 2>&1 | sed 's/^/    /' || true

    echo "$new_commit" > "$state"
    log_history config "$latest_tag" "$new_commit"
    echo "==> Config updated to $latest_tag"
}

rollback_config() {
    if [ ! -f "$HISTORY" ]; then
        echo "No update history — nothing to roll back." >&2
        return 1
    fi
    local prev_tag
    prev_tag="$(grep -P '^\S+\tconfig\t' "$HISTORY" | tail -2 | head -1 | cut -f3)"
    if [ -z "$prev_tag" ]; then
        echo "No previous config release to roll back to." >&2
        return 1
    fi
    echo "==> Rolling back config to $prev_tag..."
    update_config "$prev_tag"
}

# update_the_den [target_tag] — installs The Den (jamesyoungdahr-debug/
# the-den, a native systemd service) if it's not present yet, or updates
# it in place if it is. Mirrors that repo's own PKGBUILD/the-den.install
# (verified there via makepkg/pacman/systemctl) step for step, just
# executed directly instead of through a rebuilt pacman package — avoids
# needing a full build toolchain on the installed system for what's really
# just "copy files + venv + pip install", which the PKGBUILD's package()
# does too.
# pkgbuild_depends <PKGBUILD> — prints the package names from the file's
# depends=(...) array, one per line, version constraints stripped. Handles
# the array spanning several lines. Prints nothing if there is none.
pkgbuild_depends() {
    [ -f "$1" ] || return 0
    # awk rather than a sed range: a sed range only starts looking for the
    # closing ")" on the line AFTER the start line, so a one-line
    # depends=(...) ran on into makedepends and package() — seen live
    # 2026-09-11, pacman was asked to install "package {".
    awk '/^depends=\(/ { f = 1 } f { print } f && /\)/ { f = 0 }' "$1" \
        | sed -e 's/^depends=//' -e "s/[()'\"]//g" -e 's/#.*//' \
        | tr ' ' '\n' | sed -e 's/[<>=].*//' | grep -v '^$' || true
}

# install_pkgbuild_depends <PKGBUILD> <label> — pacman -S --needed every
# package the app's PKGBUILD depends on. No-op when nothing is missing, and
# skipped in the image-build chroot (see install_the_den's comment).
install_pkgbuild_depends() {
    local pkgbuild="$1" label="$2" deps missing=()
    mapfile -t deps < <(pkgbuild_depends "$pkgbuild")
    [ "${#deps[@]}" -gt 0 ] || return 0
    local d
    for d in "${deps[@]}"; do
        pacman -Qq "$d" >/dev/null 2>&1 || missing+=("$d")
    done
    [ "${#missing[@]}" -gt 0 ] || return 0
    if ! booted; then
        echo "==> WARNING: $label needs ${missing[*]} — not installed in the image (add to packages.x86_64)" >&2
        return 0
    fi
    echo "==> Installing system packages $label needs: ${missing[*]}"
    pacman -S --noconfirm --needed "${missing[@]}" || {
        echo "==> Could not install ${missing[*]} — $label update aborted before touching any files" >&2
        return 1
    }
}

# booted — true when a real systemd is running (sd_booted(3) semantics).
# False inside the image-build chroot (customize_airootfs.sh → `vendor`
# below), where `systemctl enable` still works (it just writes symlinks)
# but daemon-reload / --now / restart cannot.
booted() { [ -d /run/systemd/system ]; }

update_the_den() {
    local target_tag="${1:-}"
    local repo="jamesyoungdahr-debug/the-den"
    local new_commit latest_tag src_dir

    echo "==> Looking up the latest The Den release..."
    if ! IFS=$'\t' read -r new_commit latest_tag < <(resolve_release "$repo" "$target_tag"); then
        echo "No tagged The Den release found${target_tag:+ ($target_tag)}." >&2
        return 1
    fi

    echo "==> Downloading The Den $latest_tag..."
    src_dir="$(mktemp -d)"
    download_release "$repo" "$latest_tag" "$src_dir"
    install_the_den "$src_dir" "$latest_tag" "$new_commit"
    rm -rf "$src_dir"
}

# install_the_den <src_dir> <tag> <commit> — installs (first time) or
# updates (in place) The Den from an already-extracted release tree. Shared
# by update_the_den (tray updater, downloads first) and `vendor` (image
# build, uses the tree build-vendor-apps.sh staged under /opt/holtos-vendor).
install_the_den() {
    local src_dir="$1" latest_tag="$2" new_commit="$3"
    local app_dir="/opt/the-den"
    local first_install=0
    [ -d "$app_dir" ] || first_install=1

    # OS-level dependencies: whatever this release's own PKGBUILD declares
    # in depends=(...). Installed with pacman before anything else changes,
    # so a release that grows a new system dependency (v0.2.0's built-in
    # torrent client needs libtorrent-rasterbar's Python bindings — no PyPI
    # wheel for the shipped CPython) works on an existing install. Real
    # outage 2026-09-11: updating v0.1.0 → v0.2.0 died with "No module
    # named libtorrent" because nothing installed it. Skipped at image
    # build (no keyring in the chroot); build-vendor-apps.sh checks the
    # same list against packages.x86_64 and fails the build if one is
    # missing, so a fresh image always has them.
    install_pkgbuild_depends "$src_dir/PKGBUILD" "The Den" || return 1

    # The deploy/ files (service unit, sysusers, tmpfiles) are re-installed
    # on EVERY update, not just the first: a release can add directories
    # (v0.2.0 added downloads/ and state/) or change the unit. Only the env
    # file is left alone after first install — it holds the user's values.
    echo "==> Installing service files..."
    install -Dm644 "$src_dir/deploy/the-den-sysusers.conf" /usr/lib/sysusers.d/the-den.conf
    install -Dm644 "$src_dir/deploy/the-den-tmpfiles.conf" /usr/lib/tmpfiles.d/the-den.conf
    install -Dm644 "$src_dir/deploy/the-den.service" /usr/lib/systemd/system/the-den.service
    systemd-sysusers the-den.conf
    systemd-tmpfiles --create the-den.conf
    install -dm755 "$app_dir"
    if [ -f /etc/the-den/the-den.env ]; then
        # Carry settings the new release introduced into the existing env
        # file with the release's own default values, and never touch keys
        # the user already has. Necessary, not cosmetic: v0.2.0 added
        # STATE_DIR, and without it the app fell back to a relative "state"
        # under root-owned /opt/the-den and died with PermissionError
        # (seen live 2026-09-11 right after the libtorrent fix).
        local new_lines
        new_lines="$(grep -E '^[A-Z_]+=' "$src_dir/deploy/the-den.env.example" \
            | grep -vF -f <(grep -oE '^[A-Z_]+=' /etc/the-den/the-den.env) || true)"
        if [ -n "$new_lines" ]; then
            echo "==> New settings in $latest_tag, added to /etc/the-den/the-den.env with release defaults:"
            echo "$new_lines" | sed 's/^/    /'
            {
                echo
                echo "# Added by the HoltOS updater for The Den $latest_tag (release defaults; edit as needed)"
                echo "$new_lines"
            } >> /etc/the-den/the-den.env
        fi
    else
        install -Dm640 "$src_dir/deploy/the-den.env.example" /etc/the-den/the-den.env
    fi

    if [ "$first_install" -eq 1 ]; then
        echo "==> Setting up The Den for the first time..."
        cp /usr/share/icons/hicolor/scalable/apps/holtos-logo.svg \
           /usr/share/icons/hicolor/scalable/apps/the-den.svg 2>/dev/null || true
        cat > /usr/share/applications/the-den.desktop <<DESKTOP
[Desktop Entry]
Type=Application
Name=The Den
Comment=Movie/TV library manager
Exec=xdg-open http://127.0.0.1:8686
Icon=the-den
Categories=AudioVideo;Video;
DESKTOP
        # The same airootfs is the live medium too — keep the service
        # off there (same /run/archiso gate as the tray and the
        # first-boot units; the live session is a read-only squashfs).
        mkdir -p /etc/systemd/system/the-den.service.d
        cat > /etc/systemd/system/the-den.service.d/holtos-live.conf <<DROPIN
[Unit]
ConditionPathExists=!/run/archiso
DROPIN
    fi

    echo "==> Syncing application files..."
    rsync -a --delete "$src_dir/app/" "$app_dir/app/"
    rsync -a --delete "$src_dir/migrations/" "$app_dir/migrations/"
    cp "$src_dir/requirements.txt" "$app_dir/requirements.txt"
    cp "$src_dir/alembic.ini" "$app_dir/alembic.ini"

    if [ "$first_install" -eq 1 ]; then
        echo "==> Creating Python virtual environment..."
        python -m venv --system-site-packages "$app_dir/.venv"
    elif grep -q '^include-system-site-packages = false' "$app_dir/.venv/pyvenv.cfg" 2>/dev/null; then
        # venvs made by older HoltOS releases were sealed off from system
        # site-packages; flip the flag in place rather than rebuild them.
        echo "==> Opening the virtual environment to system site-packages..."
        sed -i 's/^include-system-site-packages = false/include-system-site-packages = true/' "$app_dir/.venv/pyvenv.cfg"
    fi
    echo "==> Installing Python dependencies..."
    "$app_dir/.venv/bin/python" -m pip install --no-cache-dir -q -r "$app_dir/requirements.txt"

    echo "==> Applying database migrations..."
    ( cd "$app_dir" && DATABASE_URL="sqlite:////var/lib/the-den/den.db" \
        runuser -u the-den -- "$app_dir/.venv/bin/python" -m alembic upgrade head )

    if booted; then
        systemctl daemon-reload
        if [ "$first_install" -eq 1 ]; then
            echo "==> Enabling and starting The Den..."
            systemctl enable --now the-den
        else
            echo "==> Restarting The Den..."
            systemctl restart the-den
        fi
        # A restart that crashes right back is not a successful update.
        # Real case 2026-09-11: v0.1.0 → v0.2.0 restarted into a Python
        # import error and the tray still said "Done"; the user found out
        # from the browser's "connection refused". Wait for the service AND
        # its port, and on failure surface the journal in the dialog.
        echo "==> Waiting for The Den to come up..."
        local i up=0
        for i in $(seq 1 30); do
            if systemctl is-active --quiet the-den && curl -fs -o /dev/null --max-time 2 http://127.0.0.1:8686/ 2>/dev/null; then
                up=1; break
            fi
            if systemctl is-failed --quiet the-den; then break; fi
            sleep 1
        done
        if [ "$up" -ne 1 ]; then
            echo "==> The Den did not come back after the update ($(systemctl is-active the-den)). Last log lines:" >&2
            journalctl -u the-den -n 15 --no-pager -o cat 2>/dev/null | grep -v '^\s*[~^]' | tail -12 >&2
            log_history the-den "$latest_tag (FAILED to start)" "$new_commit"
            return 1
        fi
        echo "==> The Den is up on http://127.0.0.1:8686"
    else
        # Image build: enable only (symlink); it starts on the installed
        # system's first boot.
        echo "==> Enabling The Den (image build — starts on first boot)..."
        systemctl enable the-den
    fi
    if [ "$first_install" -eq 1 ]; then
        echo "==> Running with placeholder settings from the-den.env.example"
        echo "    (empty TMDB_API_KEY, default qBittorrent credentials) —"
        echo "    edit /etc/the-den/the-den.env and restart it once you have"
        echo "    real values: systemctl restart the-den"
    fi

    log_history the-den "$latest_tag" "$new_commit"
    echo "==> The Den updated to $latest_tag"
}

# update_the_den_client [target_tag] — installs/updates The Den Client
# (jamesyoungdahr-debug/the-den-client), a PySide6/Kirigami desktop app.
# No systemd service (it's a GUI app the user launches), no venv (it has
# no pip dependencies beyond the pyside6/kirigami/qqc2-desktop-style
# system packages, already in packages.x86_64) — just synced files plus
# the repo's own official launcher/.desktop/icon (deploy/), the same way
# update_the_den installs the-den's own deploy/ files rather than
# reinventing them. (This function used to hand-write its own launcher
# and .desktop — the repo didn't ship deploy/ yet when it was first
# written. It does now; switched to using the real ones.)
update_the_den_client() {
    local target_tag="${1:-}"
    local repo="jamesyoungdahr-debug/the-den-client"
    local new_commit latest_tag src_dir

    echo "==> Looking up the latest The Den Client release..."
    if ! IFS=$'\t' read -r new_commit latest_tag < <(resolve_release "$repo" "$target_tag"); then
        echo "No tagged The Den Client release found${target_tag:+ ($target_tag)}." >&2
        return 1
    fi

    echo "==> Downloading The Den Client $latest_tag..."
    src_dir="$(mktemp -d)"
    download_release "$repo" "$latest_tag" "$src_dir"
    install_the_den_client "$src_dir" "$latest_tag" "$new_commit"
    rm -rf "$src_dir"
}

# install_the_den_client <src_dir> <tag> <commit> — same split as
# install_the_den: shared by the tray updater and the image-build `vendor`.
install_the_den_client() {
    local src_dir="$1" latest_tag="$2" new_commit="$3"
    local app_dir="/opt/the-den-client"
    local first_install=0
    [ -d "$app_dir" ] || first_install=1

    install_pkgbuild_depends "$src_dir/PKGBUILD" "The Den Client" || return 1

    echo "==> Syncing application files..."
    install -dm755 "$app_dir"
    rsync -a --delete "$src_dir/src/" "$app_dir/src/"

    if [ "$first_install" -eq 1 ]; then
        echo "==> Installing launcher, .desktop entry, and icon..."
        install -Dm755 "$src_dir/deploy/the-den-client" /usr/bin/the-den-client
        install -Dm644 "$src_dir/deploy/the-den-client.desktop" /usr/share/applications/the-den-client.desktop
        install -Dm644 "$src_dir/assets/logo.svg" /usr/share/icons/hicolor/scalable/apps/the-den-client.svg
    fi

    log_history the-den-client "$latest_tag" "$new_commit"
    echo "==> The Den Client updated to $latest_tag"
}

# vendor — image-build entry point (customize_airootfs.sh, inside the
# mkarchiso chroot): install both apps from the release trees that
# build-vendor-apps.sh staged under /opt/holtos-vendor, record them in
# history.log, and remove the staging trees so they don't ship in the ISO.
vendor_install() {
    local manifest=/opt/holtos-vendor/manifest line app tag commit lines
    [ -f "$manifest" ] || { echo "vendor: $manifest missing (run build-vendor-apps.sh)" >&2; return 1; }
    # Read the whole manifest up front: the installers below run pip,
    # alembic, rsync... any of which could otherwise swallow the loop's
    # stdin and silently skip the next line.
    mapfile -t lines < "$manifest"
    for line in "${lines[@]}"; do
        IFS=$'\t' read -r app tag commit <<< "$line"
        [ -n "$app" ] || continue
        echo "==> Vendoring $app $tag..."
        case "$app" in
            the-den)        install_the_den        "/opt/holtos-vendor/$app" "$tag" "$commit" ;;
            the-den-client) install_the_den_client "/opt/holtos-vendor/$app" "$tag" "$commit" ;;
            *) echo "vendor: unknown app '$app' in manifest" >&2; return 1 ;;
        esac
    done
    rm -rf /opt/holtos-vendor
}

update_system() {
    # Same best-effort reasoning as update_config()'s own snapshot call —
    # this is the one most worth having, since a kernel/package upgrade is
    # the update most likely to actually break boot.
    /usr/local/bin/holtos-btrfs-snapshot system || echo "==> WARNING: pre-update snapshot failed, continuing without one" >&2

    echo "==> Updating system packages (pacman -Syu)..."
    pacman -Syu --noconfirm
    log_history system pacman "$(date -u +%FT%TZ)"
}

if [ "$(id -u)" -ne 0 ]; then
    echo "holtos-update-apply must run as root (use: pkexec holtos-update-apply ...)" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: holtos-update-apply <config|the-den|the-den-client|rollback|system|vendor> ..." >&2
    exit 1
fi

# Each item is attempted independently — one failing (e.g. The Den has no
# tagged release yet) must not abort the rest of the batch. set -e only
# skips its automatic-exit behavior for commands on the left of "||", so
# every dispatch below is wrapped that way rather than relying on set -e.
failed=()
for item in "$@"; do
    case "$item" in
        config) update_config || failed+=("$item") ;;
        rollback) rollback_config || failed+=("$item") ;;
        system) update_system || failed+=("$item") ;;
        the-den) update_the_den || failed+=("$item") ;;
        the-den-client) update_the_den_client || failed+=("$item") ;;
        vendor) vendor_install || failed+=("$item") ;;
        *) echo "Unknown item: $item" >&2; failed+=("$item") ;;
    esac
done

if [ "${#failed[@]}" -gt 0 ]; then
    echo "==> Failed: ${failed[*]}" >&2
    exit 1
fi
echo "==> Done."
