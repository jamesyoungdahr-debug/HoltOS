#!/bin/bash
# Lets the user pick exactly which pieces to update — The Den / The Den
# Client (separately-maintained companion repos), the shared config
# (install/boot scripts), and/or system packages — rather than updating
# everything at once. Runs the selected items through a single pkexec
# prompt and shows progress in a yad dialog.
ICON=/usr/share/icons/hicolor/scalable/apps/holtos-logo.svg

result="$(yad --form --title="HoltOS Updater" --image="$ICON" --window-icon="$ICON" \
    --text="<b>Select what to update</b>" \
    --width=380 --center \
    --field="The Den:CHK" FALSE \
    --field="The Den Client:CHK" FALSE \
    --field="Config (install/boot scripts):CHK" FALSE \
    --field="System Packages (pacman):CHK" FALSE \
    --button="Apply:0" --button="Cancel:1")"
rc=$?
[ "$rc" -eq 0 ] || exit 0
[ -n "$result" ] || exit 0

IFS='|' read -r f_theden f_thedenclient f_config f_system <<< "$result"

items=()
[ "$f_theden" = "TRUE" ] && items+=(the-den)
[ "$f_thedenclient" = "TRUE" ] && items+=(the-den-client)
[ "$f_config" = "TRUE" ] && items+=(config)
[ "$f_system" = "TRUE" ] && items+=(system)

if [ "${#items[@]}" -eq 0 ]; then
    yad --title="HoltOS Updater" --window-icon="$ICON" \
        --text="Nothing selected." --button="Close:0"
    exit 0
fi

# Captured to a file (not just streamed through to the progress dialog,
# which --auto-close closes the instant the process exits, before there's
# any chance to read the last line) so a failure can show *why* it
# failed instead of a generic guess.
logfile="$(mktemp)"
pkexec /usr/local/bin/holtos-update-apply "${items[@]}" 2>&1 | tee "$logfile" \
    | stdbuf -oL sed -u 's/^==> /#/' \
    | yad --progress --pulsate --auto-close --auto-kill \
        --title="HoltOS Updater" --image="$ICON" --window-icon="$ICON" \
        --text="Updating HoltOS..." --width=420 --center \
        --no-buttons

status=${PIPESTATUS[0]}
if [ "$status" -ne 0 ]; then
    detail="$(tail -8 "$logfile")"
    yad --image=dialog-error --title="HoltOS Updater" --window-icon="$ICON" \
        --width=520 --wrap \
        --text="Update failed (exit $status):\n\n${detail}" \
        --button="Close:0"
else
    yad --image="$ICON" --title="HoltOS Updater" --window-icon="$ICON" \
        --text="Done. Everything's up to date." --button="Close:0"
fi
rm -f "$logfile"
