#!/usr/bin/env python3
# System tray icon for HoltOS: update status at a glance, plus the HoltOS
# tools menu.
#
# The tray does not run update checks itself any more: the root
# holtos-update-check.timer checks on the schedule set in HoltOS Updates >
# Settings and writes /var/lib/holtos/update-status.json. The tray only reads
# that file, so nobody has to click anything to find out about updates. It
# notifies once for each newly found set of updates, and when an install
# needs a restart.
#
# PySide6's QSystemTrayIcon rather than yad --notification: yad's tray mode
# is built on GTK3's X11-only GtkStatusIcon and never worked in the Plasma
# Wayland session (confirmed from the old version's log).
import json
import os
import subprocess
import sys
import time

LOG_PATH = "/tmp/holtos-tray.log"


def log(msg):
    try:
        with open(LOG_PATH, "a") as f:
            f.write(f"{msg}\n")
    except OSError:
        pass


try:
    from PySide6.QtCore import QTimer
    from PySide6.QtGui import QAction, QIcon
    from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon
except Exception as exc:  # pragma: no cover - diagnostic path only
    log(f"holtos-tray: failed to import PySide6: {exc}")
    sys.exit(1)

# The updater is for the INSTALLED system only. The live medium, the one
# environment where /run/archiso exists, gets the same autostart entry.
if os.path.exists("/run/archiso"):
    log("holtos-tray: live medium detected (/run/archiso), not starting")
    sys.exit(0)

ICON_PATH = "/usr/share/icons/hicolor/scalable/apps/holtos-logo.svg"
STATUS_PATH = "/var/lib/holtos/update-status.json"
REBOOT_MARKER = "/run/holtos-reboot-required"
POLL_MS = 30000


def run(cmd, *args):
    subprocess.Popen([cmd, *args])


def read_status():
    try:
        with open(STATUS_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def add_gamemode_toggle(menu):
    """
    Adds a toggleable "Start in Game Mode" action to the given menu.
    """
    action = QAction("Start in Game Mode", menu)
    action.setCheckable(True)

    try:
        with open("/etc/holtos/session.conf", "r") as file:
            for line in file:
                if line.strip() == "DEFAULT=gamemode":
                    action.setChecked(True)
                    break
    except Exception:
        pass

    def on_toggle(checked):
        proc = subprocess.run(
            ["pkexec", "/usr/local/bin/holtos-session-apply", "--default", "gamemode" if checked else "plasma"],
            capture_output=True,
            text=True
        )
        if proc.returncode != 0:
            action.blockSignals(True)
            action.setChecked(not checked)
            action.blockSignals(False)
            log(f"holtos-tray: session-apply failed: {proc.stderr.strip()}")

    action.triggered.connect(on_toggle)
    menu.addAction(action)
    return action


class UpdateWatcher:
    """Polls the updater's status file and keeps the tray in step with it."""

    def __init__(self, tray, updates_action):
        self.tray = tray
        self.updates_action = updates_action
        self.notified_updates = None
        self.notified_restart = False
        self.timer = QTimer()
        self.timer.timeout.connect(self.poll)
        self.timer.start(POLL_MS)
        self.poll()

    def poll(self):
        status = read_status() or {}
        state = status.get("state")
        updates = status.get("updates", [])
        names = ", ".join(u.get("name") or u.get("id", "?") for u in updates)

        if state == "checking":
            self.tray.setToolTip("HoltOS: checking for updates...")
        elif updates:
            self.tray.setToolTip(f"HoltOS: {len(updates)} update(s) available: {names}")
        elif state == "error":
            self.tray.setToolTip("HoltOS: the last update check failed")
        else:
            self.tray.setToolTip("HoltOS: up to date")

        if updates:
            self.updates_action.setText(f"HoltOS Updates ({len(updates)} available)...")
        else:
            self.updates_action.setText("HoltOS Updates...")

        found = sorted(f"{u.get('id')}:{u.get('new')}" for u in updates)
        if updates and state != "checking" and found != self.notified_updates:
            self.notified_updates = found
            self.tray.showMessage(
                "HoltOS updates available", f"{names}. Click to see them.",
                QIcon(ICON_PATH), 10000,
            )
        elif not updates:
            self.notified_updates = None

        restart = os.path.exists(REBOOT_MARKER)
        if restart and not self.notified_restart:
            try:
                with open(REBOOT_MARKER) as f:
                    reason = f.read().strip()
            except OSError:
                reason = "updates were installed"
            self.tray.showMessage(
                "Restart to finish updating", f"HoltOS needs a restart: {reason}.",
                QIcon(ICON_PATH), 15000,
            )
        self.notified_restart = restart


def main():
    log(f"=== holtos-tray started {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} ===")

    # QApplication must exist before any other QtWidgets call: calling
    # QSystemTrayIcon.isSystemTrayAvailable() first segfaulted on the Btrfs
    # install (coredumpctl, SIGSEGV inside that call, every time).
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)

    if not QSystemTrayIcon.isSystemTrayAvailable():
        log("holtos-tray: QSystemTrayIcon.isSystemTrayAvailable() is False")

    tray = QSystemTrayIcon(QIcon(ICON_PATH))
    tray.setToolTip("HoltOS")

    menu = QMenu()
    updates_action = menu.addAction("HoltOS Updates...", lambda: run("/usr/local/bin/holtos-updates"))
    menu.addAction("Rollback Config", lambda: run("/usr/local/bin/holtos-rollback-config"))
    menu.addSeparator()
    menu.addAction("Create Snapshot Now", lambda: run("/usr/local/bin/holtos-snapshot-now"))
    menu.addAction("Restore Snapshot...", lambda: run("/usr/local/bin/holtos-restore-snapshot"))
    menu.addAction("Rescan Boot Menu", lambda: run("/usr/local/bin/holtos-rescan-bootmenu"))
    menu.addSeparator()
    menu.addAction("Network Shares...", lambda: run("/usr/local/bin/holtos-shares"))
    menu.addAction("Gaming...", lambda: run("/usr/local/bin/holtos-gaming"))
    menu.addAction("Update Proton GE", lambda: run("/usr/local/bin/holtos-update-proton-ge"))
    menu.addAction("Game Mode now", lambda: run("/usr/local/bin/steamos-session-select", "gamescope"))
    add_gamemode_toggle(menu)
    menu.addSeparator()
    menu.addAction("Quit", app.quit)
    tray.setContextMenu(menu)

    def on_activated(reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            run("/usr/local/bin/holtos-updates")

    tray.activated.connect(on_activated)
    tray.messageClicked.connect(lambda: run("/usr/local/bin/holtos-updates"))
    tray.show()
    log("holtos-tray: tray icon shown")

    watcher = UpdateWatcher(tray, updates_action)
    exit_code = app.exec()
    del watcher
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
