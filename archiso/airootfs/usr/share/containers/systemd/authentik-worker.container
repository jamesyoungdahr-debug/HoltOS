# Authentik background worker — runs the same image as authentik-server but
# with the "worker" command, per Authentik's documented compose topology.
# This is what actually applies the blueprint in homepage-oidc.yaml.

[Unit]
Description=Authentik worker
After=postgres.service redis.service
Requires=postgres.service redis.service

[Container]
Image=ghcr.io/goauthentik/server:2025.8
ContainerName=authentik-worker
Exec=worker
Network=homelab.network
EnvironmentFile=/var/mnt/tank/appdata/secrets/authentik.env
# :U — see authentik-server.container for why this is needed here.
Volume=/var/mnt/tank/appdata/authentik/media:/media:U
Volume=/var/mnt/tank/appdata/authentik/certs:/certs:U
Volume=/etc/authentik/blueprints/homepage-oidc.yaml:/blueprints/custom/homepage-oidc.yaml:ro
# Replaces Authentik's own built-in system/bootstrap.yaml (not just adds
# alongside it — same path) so the admin account is created with the OS
# account's username from the start. See bootstrap-override.yaml's own
# header for why a separate custom/-mounted rename blueprint didn't work.
Volume=/etc/authentik/blueprints/bootstrap-override.yaml:/blueprints/system/bootstrap.yaml:ro

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
