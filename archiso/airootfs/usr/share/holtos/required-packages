# Packages this HoltOS release needs on every installed system. A config
# update never installs packages, so holtos-system-extras installs whatever
# on this list is missing (one package name per line).
# 0.0.5a-alpha: the updater (checkupdates needs pacman-contrib and fakeroot,
# firmware updates need fwupd), Stash (Flatpak) and TV remotes (libcec).
pacman-contrib
fakeroot
fwupd
flatpak
flatpak-kcm
libcec
# 0.0.6-alpha: the on-screen keyboard (plasma-keyboard) and AppImages (fuse2).
plasma-keyboard
fuse2
# Neon rebrand: GTK apps put their menus in the top menu bar.
appmenu-gtk-module
# Chinese, Japanese and Korean text: Steam's language list in Game Mode showed
# empty boxes without it (Liam, 2026-09-14).
noto-fonts-cjk
# Network Shares finds servers and their shares on the local network.
avahi
nss-mdns
smbclient
# Sharing folders from this computer (off until a folder is shared).
samba
wsdd
