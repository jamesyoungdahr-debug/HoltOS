[kdeglobals][KDE]
widgetStyle=kvantum

[kdeglobals][General]
ColorScheme=HoltOS
AccentColor=177,77,255
font=Nunito,10,-1,5,400,0,0,0,0,0
menuFont=Nunito,10,-1,5,400,0,0,0,0,0
toolBarFont=Nunito,10,-1,5,400,0,0,0,0,0
smallestReadableFont=Nunito,8,-1,5,400,0,0,0,0,0
fixed=JetBrains Mono,10,-1,5,400,0,0,0,0,0

[kdeglobals][Icons]
Theme=HoltOS

# HoltOS Classic: the plain glass Plasma style, without the dock's neon rim.
[plasmarc][Theme]
name=holtos-glass-classic

[Wallpaper]
Image=HoltOS-Neon-OtterNight

[kcminputrc][Mouse]
cursorTheme=HoltOS

[kwinrc][org.kde.kdecoration2]
library=org.holtos.glass
theme=HoltOS Glass

# The panel and Plasma popups are glass only with KWin's Blur and Background
# Contrast effects on.
[kwinrc][Plugins]
blurEnabled=true
contrastEnabled=true

[ksplashrc][KSplash]
Theme=org.holtos.desktop
