# HoltOS Plasma color scheme — the "opaque twin" of HoltOS Glass, built from
# the brand tokens only (design/docs/brand-cheat-sheet.md in the-den repo):
#   deep #0D0B12 (window ground) · surface #171423 (views, header) ·
#   raised #1D1927 (buttons, tooltips) · ink #FFFFFF · ink-42 for inactive ·
#   current #B14DFF (selection, focus, links) · current-hover #C77DFF (hover) ·
#   current-deep #8F2FE0 ·
#   healthy #28E0C8 (positive ONLY) · warning #FFB84D (neutral AND negative:
#   "needs a human", never a second accent).
# Neon rebrand (2026-09-14): pulse #4F7BFF, flare #FF4FD8 and volt #C6FF3D
# are art and glow colours (the dock rim, wallpapers), never states, so they
# do not appear in this scheme.
# Structure follows BreezeDark.colors; only the values differ.

[ColorEffects:Disabled]
Color=23,20,35
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=107,107,107
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

