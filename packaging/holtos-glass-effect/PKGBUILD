# HoltOS Glass — the KWin blur effect HoltOS owns (fork of KWin 6.7's blur
# plus features ported from Better Blur). Source: forks/holtos-glass-effect
# in the HoltOS repo. build-aur-packages.sh tars that directory into the
# build dir as ${pkgname}.tar and sets HOLTOS_REV (HoltOS commit count) for
# the version, so a rebuilt package always sorts newer.
pkgname=holtos-glass-effect
pkgver=0.1.0.r${HOLTOS_REV:-0}
pkgrel=1
pkgdesc="HoltOS Glass: KWin background blur effect with force-blur, tint, rounded corners and contrast control"
arch=(x86_64)
url="https://github.com/jamesyoungdahr-debug/HoltOS"
license=(GPL-3.0-or-later)
depends=(kwin libxcb kdecoration kcmutils kconfig kcoreaddons ki18n kwidgetsaddons kwindowsystem libepoxy qt6-base)
# vulkan-headers, wayland, libdrm, qt6-declarative: KWinConfig.cmake find_dependency()s them.
makedepends=(cmake extra-cmake-modules qt6-tools qt6-declarative vulkan-headers wayland libdrm pkgconf)
options=(!debug)
source=("${pkgname}.tar")
sha256sums=('SKIP')

build() {
    cmake -B build -S "${pkgname}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DHOLTOSGLASS_WAYLAND=ON \
        -DHOLTOSGLASS_X11=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
