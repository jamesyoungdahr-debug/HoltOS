# HoltOS plasma-integration — KDE's Qt platform theme 6.7.5 (Qt 6 only) with
# HoltOS glass (G7, glass plan): Qt Quick windows get an alpha buffer and KWin
# blur plus background contrast, so Kirigami apps are glass; Plasma's own
# shell, KWin, lock screen, greeter and portals are excluded, and HOLTOS_GLASS=0
# switches it off. Source vendored in forks/holtos-plasma-integration (tag
# v6.7.5); the HoltOS changes are marked "HoltOS glass (G7)". Dependencies
# copied from Arch's plasma-integration (the Qt 5 plasma5-integration split
# package is not built).
pkgname=holtos-plasma-integration
pkgver=6.7.5.r${HOLTOS_REV:-0}
pkgrel=1
pkgdesc="Qt platform theme for Plasma with HoltOS glass for Qt Quick apps"
arch=(x86_64)
url="https://invent.kde.org/plasma/plasma-integration"
license=(LGPL-2.0-or-later)
provides=(plasma-integration=6.7.5)
conflicts=(plasma-integration)
replaces=(plasma-integration)
depends=(glibc kcolorscheme kconfig kcoreaddons kguiaddons kiconthemes ki18n kio
         kjobwidgets kservice kstatusnotifieritem kwidgetsaddons kwindowsystem
         libstdc++ libxcb libxcursor qqc2-breeze-style qqc2-desktop-style
         qt6-base qt6-declarative wayland)
makedepends=(extra-cmake-modules plasma-wayland-protocols qt6-tools)
options=(!debug)
source=("${pkgname}.tar")
sha256sums=('SKIP')

build() {
    cmake -B build -S "${pkgname}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_QT5=OFF \
        -DBUILD_QT6=ON
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
