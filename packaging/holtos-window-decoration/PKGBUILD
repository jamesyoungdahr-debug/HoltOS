# HoltOS Glass window decoration — HoltOS' fork of Klassy (Qt 6 only).
# Source: forks/holtos-window-decoration in the HoltOS repo (tarred into
# the build dir by build-aur-packages.sh, versioned by HOLTOS_REV).
# Replaces the AUR klassy package in the image (same file paths, so the
# two cannot coexist).
pkgname=holtos-window-decoration
pkgver=6.7.2.r${HOLTOS_REV:-0}
pkgrel=1
pkgdesc="HoltOS Glass: translucent, blurred window decoration and application style (fork of Klassy)"
arch=(x86_64)
url="https://github.com/jamesyoungdahr-debug/HoltOS"
license=('GPL-2.0-only AND GPL-3.0-only AND GPL-2.0-or-later AND LGPL-2.1-or-later AND MIT')
conflicts=(klassy klassy-qt5)
depends=(breeze-icons
         hicolor-icon-theme
         frameworkintegration
         gcc-libs
         glibc
         kcmutils
         kcolorscheme
         kconfig
         kcoreaddons
         kdecoration
         kguiaddons
         ki18n
         kiconthemes
         kwidgetsaddons
         kwindowsystem
         qt6-base
         qt6-declarative
         qt6-svg
         xdg-utils)
makedepends=(cmake extra-cmake-modules)
options=(!debug)
source=("${pkgname}.tar")
sha256sums=('SKIP')

build() {
    cmake -B build -S "${pkgname}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_QT5=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${pkgname}/LICENSES/MIT.txt" "${pkgdir}/usr/share/licenses/${pkgname}/MIT.txt"
    # HoltOS ships only its own themes (Liam, 2026-09-14): drop Klassy's global
    # themes, Plasma styles, colour schemes and icon themes. The window
    # decoration and its settings module stay.
    rm -rf "${pkgdir}"/usr/share/plasma/look-and-feel/org.kde.klassy*
    rm -rf "${pkgdir}"/usr/share/plasma/desktoptheme/klassy*
    rm -f "${pkgdir}"/usr/share/color-schemes/Klassy*.colors "${pkgdir}"/usr/share/color-schemes/OpalFruits*.colors
    rm -rf "${pkgdir}"/usr/share/icons/klassy "${pkgdir}"/usr/share/icons/klassy-dark
}
