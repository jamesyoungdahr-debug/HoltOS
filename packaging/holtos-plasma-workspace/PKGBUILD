# HoltOS Plasma Workspace — the plasma-workspace fork HoltOS owns (fork of KDE's
# plasma-workspace at github.com/jamesyoungdahr-debug/holtos-plasma-workspace, branch
# "holtos", pinned off tag v6.7.5). This builds a vanilla Plasma workspace so HoltOS
# can eventually customize the Plasma shell/panel/Kirigami chrome directly.
pkgname=holtos-plasma-workspace
pkgver=6.7.5.r${HOLTOS_REV:-0}
pkgrel=1
pkgdesc="HoltOS's fork of plasma-workspace (Milestone 1: vanilla build, no HoltOS customization yet)"
arch=(x86_64)
url="https://github.com/jamesyoungdahr-debug/holtos-plasma-workspace"
license=(GPL-2.0-or-later GPL-3.0-or-later LGPL-2.1-or-later)
provides=(plasma-workspace=6.7.5)
conflicts=(plasma-workspace)
replaces=(plasma-workspace)
# Mirrors extra/plasma-workspace's runtime depends (pacman -Si, 6.7.5) plus
# the extras we already needed: replaces=(plasma-workspace) drops every
# transitive dep the stock package would have pulled in, so anything missing
# here is simply absent from the image (plasmashell aborted its shell load
# because kactivitymanagerd was gone; plasma-integration/kde-cli-tools/milou/
# qt6-tools too). "kwin" resolves to holtos-kwin via its provides=.
# baloo is a build dependency as well as a runtime one: the KRunner file
# search runner is guarded by if(KF6Baloo_FOUND) in runners/CMakeLists.txt, so
# without it the runner is silently skipped and KRunner cannot search files
# (found by auditing the built package against Arch's plasma-workspace).
depends=(accountsservice appstream-qt baloo dbus fontconfig freetype2 glibc icu
         kactivitymanagerd karchive kauth kbookmarks kcmutils kcolorscheme
         kcompletion kconfig kconfigwidgets kcoreaddons kcrash kde-cli-tools
         kdeclarative kded kdbusaddons kglobalaccel kguiaddons kholidays ki18n
         kiconthemes kidletime kio kio-extras kio-fuse kirigami kirigami-addons
         kitemmodels kjobwidgets knewstuff knighttime knotifications kpackage
         kparts kpipewire krunner kquickcharts kscreenlocker kservice
         kstatusnotifieritem ksvg ksystemstats ktexteditor ktextwidgets
         kuserfeedback kwallet kwayland kwidgetsaddons kwin kwindowsystem kxmlgui
         layer-shell-qt libcanberra libice libgcc libkexiv2 libksysguard
         libplasma libqalculate libsm libstdc++ libx11 libxau libxcb libxcrypt
         libxcursor libxfixes libxft libxtst milou ocean-sound-theme
         plasma-activities plasma-activities-stats plasma-integration prison
         qt6-5compat qt6-base qt6-declarative qt6-location qt6-positioning
         qt6-svg qt6-tools qt6-virtualkeyboard sh solid systemd-libs wayland
         xcb-util xcb-util-cursor xcb-util-image xcb-util-wm xorg-xmessage
         xorg-xrdb xorg-xwayland zlib
         qt6-quick3d qt6-wayland qt6-multimedia qt6-networkauth qcoro-qt6
         kdnssd knotifyconfig kpeople breeze plasma-wayland-protocols
         libkscreen networkmanager-qt pipewire
         polkit-qt6 qqc2-desktop-style hwdata packagekit-qt6 flatpak)
makedepends=(baloo cmake extra-cmake-modules git qt6-tools pkgconf
             wayland-protocols kdoctools kwin)
options=(!debug)
source=("git+${url}.git#branch=holtos")
sha256sums=('SKIP')

build() {
    cmake -B build -S "${pkgname}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    # HoltOS ships only its own global themes (Liam, 2026-09-14): drop Breeze,
    # Breeze Dark and Breeze Twilight. HoltOS and HoltOS Classic live in the
    # image under /usr/share/plasma/look-and-feel.
    rm -rf "${pkgdir}"/usr/share/plasma/look-and-feel/org.kde.breeze.desktop \
           "${pkgdir}"/usr/share/plasma/look-and-feel/org.kde.breezedark.desktop \
           "${pkgdir}"/usr/share/plasma/look-and-feel/org.kde.breezetwilight.desktop
}
