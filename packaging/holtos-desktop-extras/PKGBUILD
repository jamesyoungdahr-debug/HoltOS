# HoltOS desktop extras — the apps HoltOS ships on top of upstream KDE.
#
# A metapackage: it exists so a new app can reach an ALREADY-INSTALLED system.
# `pacman -Suu` upgrades but never installs a package that is not already
# present, and nothing can depend on itself, so a new app only arrives on an
# existing machine when a package that machine already has depends on it.
# holtos-plasma-workspace is on every install and depends on this; this
# depends on the apps. Add future "HoltOS should ship this too" apps to
# depends= below and they ride the next update.

pkgname=holtos-desktop-extras
pkgver=1.0
pkgrel=1
pkgdesc="HoltOS apps shipped on top of upstream KDE"
arch=(any)
url="https://github.com/jamesyoungdahr-debug/HoltOS"
license=(GPL-2.0-or-later)

# KDE Partition Manager. Qt/KDE, so it follows the HoltOS glass and Kvantum
# styling (GParted is GTK and cannot blur). Its heavy library, kpmcore, is
# already on the image as a Calamares dependency, so adding the app is cheap.
# Liam, 2026-09-15: the image had no partition manager at all.
depends=(partitionmanager)

package() {
    install -Dm644 /dev/null "$pkgdir/usr/share/holtos/desktop-extras"
}
