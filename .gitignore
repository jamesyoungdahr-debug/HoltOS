# archiso build output and local VM test scratch — regenerable, large binaries
out/
vm/
local-repo/
.pacman-cache/
.publish-stage/
__pycache__/

# Wallpaper pipeline scratch (tools/wallpapers): raw ComfyUI renders, QA
# output and the Real-ESRGAN weights — regenerable and large
tools/wallpapers/renders/
tools/wallpapers/qa/
tools/wallpapers/models/

# Local copy of upstream Arch releng's archiso profile, kept only for diffing
# against during development — not part of the build (mkarchiso is pointed at
# archiso/ directly) and contains real Unix symlinks Windows git can't index.
releng-reference/

# Never commit filled-in secrets — only the .example templates
secrets/
**/*.env
!**/*.env.example
archiso/airootfs/var/lib/holtos/

# The Den / The Den Client release trees fetched by build-vendor-apps.sh for
# every build — regenerable, and installed into the image at build time.
archiso/airootfs/opt/holtos-vendor/
